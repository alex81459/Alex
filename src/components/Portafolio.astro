<script>
  const seccionPortafolio = document.querySelector<HTMLElement>('#portfolio');
  if (seccionPortafolio) {
    const categoriasPorProyecto: Record<string, string> = {
      '#portfolioModal13': 'sistemas datos', '#portfolioModal10': 'sistemas datos web', '#portfolioModal7': 'sistemas',
      '#portfolioModal11': 'automatizacion datos', '#portfolioModal12': 'automatizacion infraestructura', '#portfolioModal5': 'infraestructura datos',
      '#portfolioModal8': 'web', '#portfolioModal6': 'web', '#portfolioModal4': 'sistemas datos',
      '#portfolioModal3': 'web datos', '#portfolioModal2': 'web sistemas', '#portfolioModal1': 'sistemas',
    };
    const tarjetasPortafolio = [...seccionPortafolio.querySelectorAll<HTMLElement>('.portfolio-item')];
    const botonesFiltro = [...seccionPortafolio.querySelectorAll<HTMLButtonElement>('.boton-filtro')];
    const contenedoresPortafolio = [...seccionPortafolio.querySelectorAll<HTMLElement>('.portfolio-container')];
    const detallesPorProyecto: Record<string, { tecnologias: string; estado: string; resumen: string }> = {
      '#portfolioModal10': { tecnologias: 'Python · Flask · SQLAlchemy · MySQL', estado: 'Producción', resumen: 'Trámites digitales con ClaveÚnica, aprobaciones y trazabilidad.' },
      '#portfolioModal7': { tecnologias: 'Angular · Flask · MySQL · Docker', estado: 'Implementado', resumen: 'Gestión colaborativa de tareas, equipos y prioridades.' },
      '#portfolioModal11': { tecnologias: 'C# · Python · MySQL · SQL Server', estado: 'Producción', resumen: 'Trazabilidad documental para procesos de exportación.' },
      '#portfolioModal12': { tecnologias: 'Raspberry Pi · PLC · LAN industrial', estado: 'Implementado', resumen: 'Automatización de etiquetado e impresión industrial.' },
      '#portfolioModal5': { tecnologias: 'Python · APIs · Alertas', estado: 'Operativo', resumen: 'Supervisión de servicios y alertas en tiempo real.' },
      '#portfolioModal8': { tecnologias: 'WordPress · PHP · CSS', estado: 'Publicado', resumen: 'Sitio corporativo para presencia digital y contacto comercial.' },
      '#portfolioModal6': { tecnologias: 'HTML · CSS · JavaScript', estado: 'Publicado', resumen: 'Utilidades web para tareas técnicas frecuentes.' },
      '#portfolioModal4': { tecnologias: 'C# · Blowfish · Esteganografía LSB', estado: 'Caso técnico', resumen: 'Protección y ocultamiento de información en imágenes.' },
      '#portfolioModal3': { tecnologias: 'Aplicación web · Catálogo · Búsqueda', estado: 'Caso técnico', resumen: 'Búsqueda y administración de productos asociados.' },
      '#portfolioModal2': { tecnologias: 'Aplicación de escritorio · Gestión', estado: 'Implementado', resumen: 'Administración financiera y organizacional de un club.' },
      '#portfolioModal1': { tecnologias: 'Aplicación de escritorio · Coordinación', estado: 'Implementado', resumen: 'Registro, coordinación y despacho de emergencias.' },
    };
    tarjetasPortafolio.forEach((tarjeta) => {
      const enlace = tarjeta.querySelector<HTMLAnchorElement>('.portfolio-link');
      tarjeta.dataset.categorias = categoriasPorProyecto[enlace?.getAttribute('href') ?? ''] ?? 'sistemas';
      tarjeta.dataset.cursorContexto = 'Ver caso →';
      const detalle = detallesPorProyecto[enlace?.getAttribute('href') ?? ''];
      const pie = tarjeta.querySelector<HTMLElement>('.portfolio-caption');
      if (detalle && pie && !pie.querySelector('.portfolio-tecnologias')) {
        pie.classList.add('portfolio-caption-rich');
        const descripcion = pie.querySelector('.text-muted');
        const tecnologias = document.createElement('p');
        tecnologias.className = 'portfolio-tecnologias';
        tecnologias.textContent = detalle.tecnologias;
        const estado = document.createElement('p');
        estado.className = 'portfolio-estado';
        estado.innerHTML = '<span aria-hidden="true"></span>';
        estado.append(detalle.estado);
        const resumen = document.createElement('p');
        resumen.className = 'text-muted';
        resumen.textContent = detalle.resumen;
        const caso = document.createElement('a');
        caso.className = 'portfolio-caso';
        caso.href = enlace?.getAttribute('href') ?? '#portfolio';
        caso.dataset.bsToggle = 'modal';
        caso.innerHTML = 'Ver caso técnico <span aria-hidden="true">→</span>';
        descripcion?.replaceWith(resumen);
        pie.insertBefore(tecnologias, resumen);
        pie.insertBefore(estado, resumen);
        pie.append(caso);
      }
    });
    const arquitecturasPorProyecto: Record<string, string> = {
      '#portfolioModal8': 'WordPress · contenidos corporativos · contacto comercial',
      '#portfolioModal6': 'Interfaz web · utilidades de navegador · procesamiento local',
      '#portfolioModal4': 'Aplicación de escritorio · cifrado simétrico · procesamiento de imágenes',
      '#portfolioModal3': 'Catálogo · búsqueda · gestión de productos asociados',
      '#portfolioModal2': 'Aplicación de escritorio · operación administrativa · gestión financiera',
      '#portfolioModal1': 'Registro de emergencias · coordinación · despacho operativo',
    };
    const capaDrawer = document.querySelector<HTMLElement>('[data-drawer-capa]');
    const drawerProyecto = document.querySelector<HTMLElement>('[data-drawer-proyecto]');
    const botonCerrarDrawer = document.querySelector<HTMLButtonElement>('[data-drawer-cerrar]');
    let desencadenadorDrawer: HTMLElement | null = null;
    function cerrarDrawerProyecto() {
      if (!capaDrawer) return;
      capaDrawer.classList.remove('abierto');
      window.setTimeout(() => { capaDrawer.hidden = true; }, 220);
      document.body.classList.remove('drawer-proyecto-abierto');
      desencadenadorDrawer?.focus();
    }
    function abrirDrawerProyecto(tarjeta: HTMLElement) {
      const enlace = tarjeta.querySelector<HTMLAnchorElement>('.portfolio-link');
      const identificador = enlace?.getAttribute('href') ?? '';
      const detalle = detallesPorProyecto[identificador];
      const titulo = tarjeta.querySelector('h4')?.textContent ?? 'Proyecto';
      const imagen = tarjeta.querySelector<HTMLImageElement>('img');
      if (!capaDrawer || !drawerProyecto || !detalle) return;
      const destino = (selector: string) => drawerProyecto.querySelector<HTMLElement>(selector);
      const tituloDrawer = destino('[data-drawer-titulo]');
      const tecnologiasDrawer = destino('[data-drawer-tecnologias]');
      const arquitecturaDrawer = destino('[data-drawer-arquitectura]');
      const resumenDrawer = destino('[data-drawer-resumen]');
      const imagenDrawer = destino('[data-drawer-imagen]') as HTMLImageElement | null;
      const casoDrawer = destino('[data-drawer-caso]') as HTMLAnchorElement | null;
      if (tituloDrawer) tituloDrawer.textContent = titulo;
      if (tecnologiasDrawer) tecnologiasDrawer.textContent = detalle.tecnologias;
      if (arquitecturaDrawer) arquitecturaDrawer.textContent = arquitecturasPorProyecto[identificador] ?? 'Interfaz · lógica de negocio · datos';
      if (resumenDrawer) resumenDrawer.textContent = detalle.resumen;
      if (imagenDrawer && imagen) { imagenDrawer.src = imagen.currentSrc || imagen.src; imagenDrawer.alt = imagen.alt; }
      if (casoDrawer) casoDrawer.href = identificador;
      desencadenadorDrawer = tarjeta;
      capaDrawer.hidden = false;
      requestAnimationFrame(() => capaDrawer.classList.add('abierto'));
      document.body.classList.add('drawer-proyecto-abierto');
      drawerProyecto.focus();
    }
    tarjetasPortafolio.filter((tarjeta) => !tarjeta.classList.contains('portfolio-featured')).forEach((tarjeta) => {
      tarjeta.querySelector('.portfolio-link')?.addEventListener('click', (evento) => { evento.preventDefault(); evento.stopPropagation(); abrirDrawerProyecto(tarjeta); });
    });
    botonCerrarDrawer?.addEventListener('click', cerrarDrawerProyecto);
    capaDrawer?.addEventListener('click', (evento) => { if (evento.target === capaDrawer) cerrarDrawerProyecto(); });
    document.addEventListener('keydown', (evento) => { if (evento.key === 'Escape' && capaDrawer?.classList.contains('abierto')) cerrarDrawerProyecto(); });
    drawerProyecto?.querySelector<HTMLAnchorElement>('[data-drawer-caso]')?.addEventListener('click', () => window.setTimeout(cerrarDrawerProyecto));

    function actualizarGruposPortafolio() {
      contenedoresPortafolio.forEach((contenedor) => {
        const hayTarjetasVisibles = [...contenedor.querySelectorAll<HTMLElement>('.portfolio-item')].some((tarjeta) => !tarjeta.classList.contains('filtered-out'));
        contenedor.previousElementSibling?.toggleAttribute('hidden', !hayTarjetasVisibles);
        contenedor.toggleAttribute('hidden', !hayTarjetasVisibles);
      });
    }
    botonesFiltro.forEach((boton) => boton.addEventListener('click', () => {
      botonesFiltro.forEach((elemento) => elemento.setAttribute('aria-pressed', String(elemento === boton)));
      requestAnimationFrame(() => {
        tarjetasPortafolio.filter((tarjeta) => !tarjeta.classList.contains('filtered-out')).forEach((tarjeta, indice) => {
          tarjeta.style.setProperty('--retardo-filtro', `${indice * 45}ms`);
          tarjeta.classList.remove('tarjeta-filtrada-entrada');
          void tarjeta.offsetWidth;
          tarjeta.classList.add('tarjeta-filtrada-entrada');
