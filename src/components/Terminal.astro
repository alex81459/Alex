---
const base = import.meta.env.BASE_URL;
---

<button class="terminal-launcher" id="terminal-launcher" type="button" aria-label="Abrir terminal interactiva" aria-expanded="false">
  <i class="fa fa-terminal" aria-hidden="true"></i>
</button>

<div class="terminal-easteregg" id="terminal-easteregg" hidden aria-label="Terminal interactiva">
  <div class="terminal-egg-bar">
    <span class="terminal-egg-dots" aria-hidden="true"><span></span><span></span><span></span></span>
    <span class="terminal-egg-title">alex@portfolio: ~</span>
    <button class="terminal-egg-close" id="terminal-egg-close" type="button" aria-label="Cerrar terminal"><i class="fa fa-times" aria-hidden="true"></i></button>
  </div>
  <div class="terminal-egg-output" id="terminal-egg-output" aria-live="polite"></div>
  <div class="terminal-egg-inputline">
    <span class="terminal-egg-prompt">alex@portfolio:~$</span>
    <input class="terminal-egg-input" id="terminal-egg-input" type="text" autocomplete="off" spellcheck="false" aria-label="Escribir comando" placeholder="escribe un comando (help)">
  </div>
</div>

<style>
  .terminal-launcher {
    position: fixed;
    left: 22px;
    bottom: 22px;
    z-index: 1200;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--hud-border, var(--border));
    background: var(--hud-bg, rgba(7, 17, 31, 0.88));
    color: var(--primary);
    font-size: 1.05rem;
    cursor: pointer;
    backdrop-filter: blur(12px);
    box-shadow: 0 18px 40px var(--floating-shadow, rgba(0, 0, 0, 0.35));
    transition: var(--transition);
  }

  .terminal-launcher .fa {
    color: var(--primary);
  }

  .terminal-launcher:hover {
    background: var(--primary);
    color: var(--bg-main);
    transform: translateY(-2px);
  }

  .terminal-launcher:hover .fa {
    color: var(--bg-main);
  }

  .terminal-launcher:hover .fa {
    color: var(--bg-main);
  }

  .terminal-easteregg {
    position: fixed;
    left: 22px;
    bottom: 76px;
    z-index: 1300;
    width: min(440px, calc(100vw - 32px));
    height: min(460px, 62vh);
    display: flex;
    flex-direction: column;
    border-radius: 12px;
    border: 1px solid var(--hud-border, rgba(148, 163, 184, 0.18));
    background: #0b1220;
    color: #d7e6f2;
    font-family: 'Courier New', Consolas, Monaco, monospace;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.5);
    overflow: hidden;
    animation: eggIn 0.18s ease;
  }

  .terminal-easteregg[hidden] {
    display: none;
  }

  @keyframes eggIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .terminal-egg-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    background: rgba(255, 255, 255, 0.04);
    border-bottom: 1px solid var(--hud-border, rgba(148, 163, 184, 0.16));
  }

  .terminal-egg-dots {
    display: flex;
    gap: 6px;
  }

  .terminal-egg-dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .terminal-egg-dots span:nth-child(1) { background: #ff5f57; }
  .terminal-egg-dots span:nth-child(2) { background: #ffbd2e; }
  .terminal-egg-dots span:nth-child(3) { background: #28c840; }

  .terminal-egg-title {
    flex: 1;
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .terminal-egg-close {
    background: none;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
    font-size: 0.9rem;
    padding: 0 2px;
    line-height: 1;
  }

  .terminal-egg-close:hover {
    color: var(--text-main);
  }

  .terminal-egg-output {
    flex: 1;
    overflow-y: auto;
    padding: 12px 14px;
    font-size: 0.8rem;
    line-height: 1.6;
  }

  .egg-line {
    white-space: pre-wrap;
    word-break: break-word;
  }

  .egg-line .egg-prompt {
    color: #34d399;
    font-weight: 700;
  }

  .egg-line .egg-cmd {
    color: #7dd3fc;
  }

  .egg-skill-fill {
    color: #22d3ee;
  }

  .egg-skill-empty {
    color: #334155;
  }

  .egg-link {
    color: var(--primary);
    text-decoration: underline;
  }

  .terminal-egg-inputline {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-top: 1px solid var(--hud-border, rgba(148, 163, 184, 0.16));
    background: rgba(255, 255, 255, 0.03);
  }

  .terminal-egg-prompt {
    color: #34d399;
    font-weight: 700;
    white-space: nowrap;
  }

  .terminal-egg-input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: none;
    outline: none;
    color: #d7e6f2;
    font-family: inherit;
    font-size: 0.8rem;
    caret-color: #22d3ee;
  }

  @media (max-width: 575.98px) {
    .terminal-launcher {
      left: 12px;
      bottom: 12px;
      width: 42px;
      height: 42px;
      font-size: 0.95rem;
    }

    .terminal-easteregg {
      left: 12px;
      bottom: 64px;
      width: calc(100vw - 24px);
    }
  }
</style>

<script is:inline src={`${base}assets/js/terminal-init.js`}></script>
