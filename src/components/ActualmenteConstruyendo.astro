---
const modulosGestion = [
  {
    numero: '01',
    icono: 'fa fa-search',
    titulo: 'Identificación y evaluación',
    descripcion: 'MIPER, inspecciones, peligros, riesgos y hallazgos por establecimiento.',
  },
  {
    numero: '02',
    icono: 'fa fa-tasks',
    titulo: 'Planificación y ejecución',
    descripcion: 'Programas preventivos, responsables, medidas de control, acciones correctivas y plazos.',
  },
  {
    numero: '03',
    icono: 'fa fa-line-chart',
    titulo: 'Seguimiento y mejora continua',
    descripcion: 'Evidencias, validación técnica, evaluación de eficacia, documentación, indicadores y auditoría.',
  },
];

const capacidadesProyecto = ['Gestión preventiva', 'Control territorial', 'Auditoría', 'Trazabilidad'];
const tecnologiasProyecto = ['NestJS', 'React', 'Prisma', 'MySQL', 'Google Drive', 'PDFKit', 'Docker', 'Nginx'];
---

<section id="actualmente-construyendo" class="seccion-construccion" aria-labelledby="titulo-construccion">
  <div class="container">
    <article class="tarjeta-construccion">
      <header class="encabezado-construccion">
        <div class="identidad-proyecto">
          <span class="icono-proyecto" aria-hidden="true"><i class="fa fa-shield"></i></span>
          <div>
            <p class="nombre-proyecto">SIGSST</p>
            <p class="subtitulo-proyecto">Sistema de Gestión de Seguridad y Salud en el Trabajo</p>
          </div>
        </div>
        <span class="estado-proyecto"><span aria-hidden="true"></span> EN DESARROLLO</span>
      </header>

      <div class="propuesta-valor">
        <p class="ceja-construccion">GESTIÓN PREVENTIVA INSTITUCIONAL</p>
        <h2 id="titulo-construccion">Del riesgo detectado al control y cierre verificable<span>.</span></h2>
        <p>Plataforma institucional para gestionar la prevención de riesgos laborales, centralizando inspecciones, evaluaciones, medidas correctivas y seguimiento por establecimiento.</p>
      </div>

      <div class="modulos-gestion" aria-label="Módulos principales del SIGSST">
        {modulosGestion.map((modulo) => (
          <section class="modulo-gestion">
            <div class="cabecera-modulo">
              <span class="numero-modulo" aria-hidden="true">{modulo.numero}</span>
              <span class="icono-modulo" aria-hidden="true"><i class={modulo.icono}></i></span>
            </div>
            <h3>{modulo.titulo}</h3>
            <p>{modulo.descripcion}</p>
          </section>
        ))}
      </div>

      <footer class="pie-construccion">
        <div class="capacidades-proyecto" aria-label="Capacidades de la plataforma">
          {capacidadesProyecto.map((capacidad) => <span>{capacidad}</span>)}
        </div>
        <div class="tecnologias-construccion" aria-label="Tecnologías del proyecto">
          {tecnologiasProyecto.map((tecnologia) => <span>{tecnologia}</span>)}
        </div>
      </footer>
    </article>
  </div>
</section>

<style>
  .seccion-construccion { padding: 18px 0 48px; color: var(--texto-principal); }
  .tarjeta-construccion { overflow: hidden; padding: clamp(24px, 4vw, 36px); border: 1px solid #253449; border-radius: 16px; background: #0b1422; box-shadow: var(--sombra-superficie); transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease; }
  .tarjeta-construccion:hover { border-color: color-mix(in srgb, #38bdf8 58%, #253449); box-shadow: 0 18px 42px color-mix(in srgb, #020617 55%, transparent); transform: translateY(-3px); }
  .encabezado-construccion { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding-bottom: 21px; border-bottom: 1px solid #253449; }
  .identidad-proyecto { display: flex; align-items: center; min-width: 0; gap: 12px; }
  .icono-proyecto, .icono-modulo { display: grid; place-items: center; flex: 0 0 auto; color: #38bdf8; background: rgb(56 189 248 / 12%); }
  .icono-proyecto { width: 42px; height: 42px; border-radius: 12px; font-size: 1rem; }
  .nombre-proyecto, .subtitulo-proyecto, .propuesta-valor p, .modulo-gestion p { margin: 0; }
  .nombre-proyecto { color: #f1f5f9; font-size: clamp(1.38rem, 2vw, 1.5rem); font-weight: 700; line-height: 1; letter-spacing: -.03em; }
  .subtitulo-proyecto { margin-top: 5px; color: #94a3b8; font-size: .7rem; line-height: 1.35; }
  .estado-proyecto { display: inline-flex; align-items: center; flex: 0 0 auto; gap: 7px; padding: 6px 9px; border: 1px solid rgb(251 191 36 / 32%); border-radius: 999px; color: #fbbf24; background: rgb(251 191 36 / 8%); font: .59rem ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: .08em; white-space: nowrap; }
  .estado-proyecto > span { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .propuesta-valor { max-width: 780px; margin-top: 26px; }
  .ceja-construccion { margin-bottom: 9px !important; color: #38bdf8; font: .6rem ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: .1em; }
  .propuesta-valor h2 { max-width: 720px; margin: 0; color: #f1f5f9; font-size: clamp(1.22rem, 2.25vw, 1.55rem); font-weight: 650; line-height: 1.25; letter-spacing: -.025em; }
  .propuesta-valor h2 > span { color: #38bdf8; }
  .propuesta-valor > p:last-child { max-width: 690px; margin-top: 11px; color: #94a3b8; font-size: .83rem; line-height: 1.65; }
  .modulos-gestion { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin-top: 26px; }
  .modulo-gestion { min-width: 0; padding: 17px; border: 1px solid #253449; border-radius: 14px; background: #101e30; transition: border-color .2s ease, background .2s ease; }
  .modulo-gestion:hover { border-color: rgb(56 189 248 / 52%); background: color-mix(in srgb, #101e30 87%, #38bdf8); }
  .cabecera-modulo { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .numero-modulo { color: #94a3b8; font: .62rem ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: .08em; }
  .icono-modulo { width: 31px; height: 31px; border-radius: 9px; font-size: .78rem; }
  .modulo-gestion h3 { margin: 15px 0 7px; color: #f1f5f9; font-size: .86rem; font-weight: 600; line-height: 1.35; }
  .modulo-gestion p { color: #94a3b8; font-size: .72rem; line-height: 1.58; }
  .pie-construccion { display: grid; gap: 14px; margin-top: 24px; padding-top: 19px; border-top: 1px solid #253449; }
  .capacidades-proyecto, .tecnologias-construccion { display: flex; flex-wrap: wrap; gap: 7px; }
  .capacidades-proyecto span, .tecnologias-construccion span { padding: 5px 8px; border-radius: 6px; font: .61rem ui-monospace, SFMono-Regular, Consolas, monospace; line-height: 1; }
  .capacidades-proyecto span { border: 1px solid rgb(56 189 248 / 27%); color: #7dd3fc; background: rgb(56 189 248 / 8%); }
  .tecnologias-construccion span { border: 1px solid #253449; color: #94a3b8; background: rgb(15 23 42 / 55%); }
  @media (max-width: 767px) { .seccion-construccion { padding: 8px 0 38px; } .tarjeta-construccion { padding: 24px; } .modulos-gestion { grid-template-columns: 1fr; } }
  @media (max-width: 440px) { .encabezado-construccion { align-items: flex-start; flex-direction: column; } .estado-proyecto { margin-left: 54px; } .subtitulo-proyecto { max-width: 220px; } }
  @media (prefers-reduced-motion: reduce) { .tarjeta-construccion, .modulo-gestion { transition: none; } .tarjeta-construccion:hover { transform: none; } }
</style>
