<div id="command-palette" class="command-palette" hidden role="dialog" aria-modal="true" aria-labelledby="command-palette-title">
  <div class="command-palette-panel">
    <div class="command-palette-search">
      <i class="fa fa-search" aria-hidden="true"></i>
      <input id="command-palette-input" type="search" autocomplete="off" placeholder="Buscar una sección o acción…" aria-label="Buscar un comando" />
      <kbd>ESC</kbd>
    </div>
    <div class="command-palette-results" id="command-palette-results">
      <p id="command-palette-title" class="command-palette-label">NAVEGACIÓN</p>
      <button type="button" data-command="section" data-target="#page-top"><span><i class="fa fa-home" aria-hidden="true"></i> Inicio</span><kbd>↵</kbd></button>
      <button type="button" data-command="section" data-target="#portfolio"><span><i class="fa fa-folder-open" aria-hidden="true"></i> Proyectos</span><kbd>↵</kbd></button>
      <button type="button" data-command="section" data-target="#actualmente-construyendo"><span><i class="fa fa-rocket" aria-hidden="true"></i> Actualmente construyendo</span><kbd>↵</kbd></button>
      <button type="button" data-command="section" data-target="#experiencia"><span><i class="fa fa-briefcase" aria-hidden="true"></i> Experiencia</span><kbd>↵</kbd></button>
      <button type="button" data-command="section" data-target="#tech-stack"><span><i class="fa fa-code" aria-hidden="true"></i> Tecnologías</span><kbd>↵</kbd></button>
      <button type="button" data-command="section" data-target="#contact"><span><i class="fa fa-envelope" aria-hidden="true"></i> Contacto</span><kbd>↵</kbd></button>
      <p class="command-palette-label">ACCIONES</p>
      <button type="button" data-command="modal" data-target="#portfolioModal9"><span><i class="fa fa-book" aria-hidden="true"></i> Abrir: Libro de Clases Digital</span><kbd>↵</kbd></button>
      <button type="button" data-command="terminal"><span><i class="fa fa-terminal" aria-hidden="true"></i> Abrir terminal interactiva</span><kbd>↵</kbd></button>
      <p class="command-palette-empty" hidden>No hay comandos que coincidan.</p>
    </div>
    <p class="command-palette-footer"><span><kbd>↑↓</kbd> navegar</span><span><kbd>↵</kbd> abrir</span><span><kbd>ESC</kbd> cerrar</span></p>
  </div>
</div>

<style>
  .command-palette[hidden] { display: none; }
  .command-palette { position: fixed; inset: 0; z-index: 2000; display: grid; place-items: start center; padding: min(15vh, 130px) 18px 24px; background: color-mix(in srgb, var(--fondo-principal) 64%, transparent); backdrop-filter: blur(8px); }
  .command-palette-panel { width: min(620px, 100%); overflow: hidden; border: 1px solid var(--borde-destacado); border-radius: 13px; background: var(--fondo-tarjeta); box-shadow: 0 28px 80px var(--sombra-flotante); animation: command-palette-in .16s ease-out; }
  .command-palette-search { display: flex; align-items: center; gap: 12px; padding: 15px 16px; border-bottom: 1px solid var(--borde); color: var(--primario); }
  .command-palette-search input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; color: var(--texto-principal); font: inherit; font-size: .9rem; }
  .command-palette-search input::placeholder { color: var(--texto-secundario); }
  .command-palette kbd { padding: 2px 5px; border: 1px solid var(--borde-destacado); border-radius: 4px; color: var(--texto-secundario); background: var(--fondo-tarjeta-alternativo); font: .58rem ui-monospace, SFMono-Regular, Consolas, monospace; }
  .command-palette-results { max-height: min(55vh, 480px); overflow-y: auto; padding: 9px; }
  .command-palette-label { margin: 10px 8px 6px; color: var(--texto-secundario); font: .55rem ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: .12em; }
  .command-palette-results button { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 42px; padding: 9px 10px; border: 0; border-radius: 7px; color: var(--texto-principal); background: transparent; font-size: .78rem; text-align: left; }
  .command-palette-results button span { display: inline-flex; align-items: center; gap: 10px; }
  .command-palette-results button i { width: 14px; color: var(--primario); text-align: center; }
  .command-palette-results button:hover, .command-palette-results button:focus-visible { color: var(--texto-principal); background: var(--primario-suave); outline: none; }
  .command-palette-empty { margin: 22px 8px; color: var(--texto-secundario); font-size: .78rem; text-align: center; }
  .command-palette-footer { display: flex; flex-wrap: wrap; gap: 8px 18px; margin: 0; padding: 11px 17px; border-top: 1px solid var(--borde); color: var(--texto-secundario); font-size: .62rem; }
  .command-palette-footer span { display: inline-flex; align-items: center; gap: 5px; }
  @keyframes command-palette-in { from { opacity: 0; transform: translateY(-8px) scale(.985); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .command-palette-panel { animation: none; } }
</style>

<script>
  const paleta = document.getElementById('command-palette');
  const entradaPaleta = document.getElementById('command-palette-input') as HTMLInputElement | null;
  const resultadosPaleta = document.getElementById('command-palette-results');
  const disparadorPaleta = document.getElementById('command-palette-trigger');
  const comandosPaleta = resultadosPaleta ? [...resultadosPaleta.querySelectorAll<HTMLButtonElement>('[data-command]')] : [];
  const vacioPaleta = resultadosPaleta?.querySelector<HTMLElement>('.command-palette-empty');
  let focoAnterior: HTMLElement | null = null;

  function cerrarPaleta() {
    if (!paleta || paleta.hidden) return;
    paleta.hidden = true;
    entradaPaleta!.value = '';
    comandosPaleta.forEach((comando) => { comando.hidden = false; });
    vacioPaleta!.hidden = true;
    focoAnterior?.focus({ preventScroll: true });
  }

  function abrirPaleta() {
    if (!paleta || !entradaPaleta || !paleta.hidden) return;
    focoAnterior = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    paleta.hidden = false;
    entradaPaleta.value = '';
    comandosPaleta.forEach((comando) => { comando.hidden = false; });
    vacioPaleta!.hidden = true;
    window.setTimeout(() => entradaPaleta.focus(), 0);
  }

  function ejecutarComando(boton: HTMLButtonElement) {
    const tipo = boton.dataset.command;
    const destino = boton.dataset.target;
    cerrarPaleta();

    if (tipo === 'section' && destino) {
      document.querySelector(destino)?.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      history.replaceState(null, '', destino);
    }
    if (tipo === 'modal' && destino) {
      document.querySelector<HTMLAnchorElement>(`[data-bs-toggle="modal"][href="${destino}"]`)?.click();
    }
    if (tipo === 'terminal') window.dispatchEvent(new Event('terminal:open'));
  }

  document.addEventListener('keydown', (evento) => {
    if ((evento.ctrlKey || evento.metaKey) && evento.key.toLowerCase() === 'k') {
      evento.preventDefault();
      abrirPaleta();
      return;
    }
    if (evento.key === 'Escape' && paleta && !paleta.hidden) cerrarPaleta();
  });

  disparadorPaleta?.addEventListener('click', abrirPaleta);
  paleta?.addEventListener('click', (evento) => { if (evento.target === paleta) cerrarPaleta(); });
  entradaPaleta?.addEventListener('input', () => {
    const consulta = entradaPaleta.value.trim().toLocaleLowerCase('es');
    let coincidencias = 0;
    comandosPaleta.forEach((comando) => {
      const visible = comando.textContent?.toLocaleLowerCase('es').includes(consulta) ?? false;
      comando.hidden = !visible;
      if (visible) coincidencias += 1;
    });
    vacioPaleta!.hidden = coincidencias > 0;
  });
  entradaPaleta?.addEventListener('keydown', (evento) => {
    const visibles = comandosPaleta.filter((comando) => !comando.hidden);
    if (evento.key === 'ArrowDown' && visibles.length) {
      evento.preventDefault();
      visibles[0].focus();
    }
    if (evento.key === 'Enter' && visibles.length) {
      evento.preventDefault();
      ejecutarComando(visibles[0]);
    }
  });
  comandosPaleta.forEach((comando) => comando.addEventListener('keydown', (evento) => {
    if (!['ArrowDown', 'ArrowUp'].includes(evento.key)) return;
    const visibles = comandosPaleta.filter((elemento) => !elemento.hidden);
    const indice = visibles.indexOf(comando);
    if (indice < 0) return;
    evento.preventDefault();
    visibles[(indice + (evento.key === 'ArrowDown' ? 1 : -1) + visibles.length) % visibles.length].focus();
  }));
  comandosPaleta.forEach((comando) => comando.addEventListener('click', () => ejecutarComando(comando)));
</script>
