---
const accesos = [
  { icon: 'fa-file-pdf-o', label: 'Ver CV', href: 'assets/curriculum-v3-2026.pdf', external: true },
  { icon: 'fa-linkedin-square', label: 'LinkedIn', href: 'https://www.linkedin.com/in/alex-salinas-ponce-5276691a3', external: true },
  { icon: 'fa-github', label: 'GitHub', href: 'https://github.com/alex81459', external: true },
  { icon: 'fa-envelope', label: 'Contactar', href: '#contact', external: false },
  { icon: 'fa-rocket', label: 'Ver proyectos destacados', href: '#portfolio', external: false },
];

const resumen = [
  {
    icon: 'fa-user-circle',
    title: 'Quién soy',
    lead: 'Alex Salinas Ponce · Ingeniero Informático y Desarrollador Full Stack',
    text: 'Especializado en desarrollo de sistemas, infraestructura TI, automatización y DevOps. Diseño soluciones que pasan desde la idea y la arquitectura hasta su despliegue y operación en producción.',
  },
  {
    icon: 'fa-briefcase',
    title: 'Dónde trabajo',
    lead: 'SLEP Colchagua',
    text: 'Desarrollo y mantengo sistemas e infraestructura digital que dan soporte a 69 establecimientos educacionales, integrando desarrollo de software, APIs, servidores, redes y soporte TI. Experiencia previa en Johnson Fruit y la Municipalidad de Chimbarongo.',
  },
  {
    icon: 'fa-cubes',
    title: 'Con qué construyo',
    lead: 'Angular · Python/Flask · Node.js · C# · MySQL/MariaDB · Docker · Linux · Nginx',
    text: 'Frontend, backend, APIs REST, bases de datos, contenedores, servidores y despliegues productivos.',
  },
  {
    icon: 'fa-chart-line',
    title: 'Resultados medibles',
    lead: '13+ trámites digitalizados · 10.000+ gestiones · 7 APIs · 1.000+ casos de soporte · 69 establecimientos',
    text: 'Además, soluciones de automatización que han generado ahorros de hasta $35M CLP por temporada.',
  },
  {
    icon: 'fa-shield',
    title: 'Qué me diferencia',
    lead: 'No me limito a programar interfaces',
    text: 'Construyo sistemas completos y operables en producción, incorporando ClaveÚnica, firma OTP, control de acceso, auditoría, trazabilidad documental, generación de reportes, automatización de procesos e integración entre sistemas.',
    sub: 'También cuento con experiencia en automatización industrial mediante PLC y Raspberry Pi, conectando el desarrollo de software con procesos físicos.',
  },
];
---

<section class="recruiter-zone" aria-label="Zona para reclutadores">
  <div class="container">
    <div class="recruiter-card">
      <header class="recruiter-heading">
        <span class="recruiter-kicker"><i class="fa fa-clock-o"></i> ZONA PARA RECLUTADORES</span>
        <h2 class="recruiter-title">¿Tienes poco tiempo?</h2>
        <p class="recruiter-subtitle">Acceso rápido a mi CV, redes y proyectos, junto con un resumen de 60 segundos.</p>
      </header>

      <div class="recruiter-actions">
        {accesos.map((acceso) => (
          <a class="recruiter-action" href={acceso.href} target={acceso.external ? '_blank' : undefined} rel={acceso.external ? 'noopener' : undefined}>
            <i class={`fa ${acceso.icon}`} aria-hidden="true"></i>
            <span>{acceso.label}</span>
          </a>
        ))}
      </div>

      <div class="recruiter-divider"></div>

      <h3 class="recruiter-summary-title"><i class="fa fa-bolt" aria-hidden="true"></i>Resumen en 60 segundos</h3>
      <div class="recruiter-grid">
        {resumen.map((item) => (
          <article class="recruiter-item">
            <header class="recruiter-item-head">
              <div class="recruiter-item-icon" aria-hidden="true"><i class={`fa ${item.icon}`}></i></div>
              <h4>{item.title}</h4>
            </header>
            <p class="recruiter-item-lead">{item.lead}</p>
            <p class="recruiter-item-text">{item.text}</p>
            {item.sub && <p class="recruiter-item-text">{item.sub}</p>}
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .recruiter-zone {
    padding: 70px 0;
    background: #0a1524;
    position: relative;
  }

  .recruiter-card {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 20px;
    background: var(--bg-card);
    padding: 38px 34px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
  }

  .recruiter-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--primary), #67e8f9, var(--primary));
  }

  .recruiter-heading {
    text-align: center;
    margin-bottom: 24px;
  }

  .recruiter-kicker {
    display: inline-block;
    color: var(--primary);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    margin-bottom: 8px;
  }

  .recruiter-title {
    color: var(--text-main);
    font-size: 1.9rem;
    font-weight: 800;
    margin: 0 0 8px;
  }

  .recruiter-subtitle {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .recruiter-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  .recruiter-action {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 999px;
    border: 1px solid rgba(56, 189, 248, 0.3);
    background: var(--primary-soft);
    color: var(--text-main);
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    transition: var(--transition);
  }

  .recruiter-action .fa {
    color: var(--primary);
  }

  .recruiter-action:hover {
    background: var(--primary);
    border-color: var(--primary);
    color: var(--bg-main);
    transform: translateY(-2px);
  }

  .recruiter-action:hover .fa {
    color: var(--bg-main);
  }

  .recruiter-divider {
    height: 1px;
    margin: 26px 0;
    background: linear-gradient(90deg, transparent, var(--border), transparent);
  }

  .recruiter-summary-title {
    text-align: center;
    color: var(--text-main);
    font-size: 1.25rem;
    font-weight: 800;
    margin: 0 0 20px;
  }

  .recruiter-summary-title .fa {
    color: var(--primary);
    margin-right: 6px;
  }

  .recruiter-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 14px;
  }

  .recruiter-item {
    grid-column: span 2;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 20px;
    text-align: left;
  }

  .recruiter-item:nth-child(4),
  .recruiter-item:nth-child(5) {
    grid-column: span 3;
  }

  .recruiter-item-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  .recruiter-item-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    flex: 0 0 auto;
    border-radius: 10px;
    background: var(--primary-soft);
    border: 1px solid rgba(56, 189, 248, 0.3);
    color: var(--primary);
    font-size: 1rem;
  }

  .recruiter-item h4 {
    margin: 0;
    color: var(--text-main);
    font-size: 1rem;
    font-weight: 800;
  }

  .recruiter-item-lead {
    margin: 0 0 8px;
    color: var(--text-main);
    font-size: 0.84rem;
    font-weight: 700;
    line-height: 1.5;
  }

  .recruiter-item-text {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.8rem;
    line-height: 1.55;
  }

  .recruiter-item-text + .recruiter-item-text {
    margin-top: 8px;
  }

  html[data-theme='light'] .recruiter-zone {
    background: #f4f9ff;
  }

  html[data-theme='light'] .recruiter-card {
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 20px 60px rgba(15, 23, 42, 0.08);
  }

  html[data-theme='light'] .recruiter-item {
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.05);
  }

  @media (max-width: 991.98px) {
    .recruiter-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .recruiter-item,
    .recruiter-item:nth-child(4),
    .recruiter-item:nth-child(5) {
      grid-column: span 1;
    }
  }

  @media (max-width: 575.98px) {
    .recruiter-card {
      padding: 26px 18px;
    }

    .recruiter-grid {
      grid-template-columns: 1fr;
    }

    .recruiter-item,
    .recruiter-item:nth-child(4),
    .recruiter-item:nth-child(5) {
      grid-column: span 1;
    }

    .recruiter-action {
      width: 100%;
      justify-content: center;
    }
  }
</style>
