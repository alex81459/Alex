---
const estadisticas = [
  { objetivo: 68, valorVisible: '68', etiqueta: 'Establecimientos', contexto: 'Operación TI · SLEP Colchagua', muestraMas: false },
  { objetivo: 15000, valorVisible: '15.000', etiqueta: 'Gestiones digitalizadas', contexto: 'Trámites Online en Procesos Implementados · registros 2025–2026', muestraMas: true },
  { objetivo: 12, valorVisible: '12', etiqueta: 'APIs / servicios', contexto: 'Integración institucional de bases de datos y sistemas', muestraMas: false },
];
---

<dl class="hero-metrics" aria-label="Resultados del trabajo profesional">
  {estadisticas.map((estadistica) => (
    <div class="hero-metric">
      <dt>{estadistica.etiqueta}</dt>
      <dd><span class="hero-metric-number" data-target={estadistica.objetivo}>0</span>{estadistica.muestraMas && <span class="hero-metric-plus" data-sufijo hidden>+</span>}</dd>
      <dd class="hero-metric-context">{estadistica.contexto}</dd>
    </div>
  ))}
</dl>

<script>
  const metricas = document.querySelector<HTMLElement>('.hero-metrics');
  const movimientoReducido = window.matchMedia('(prefers-reduced-motion: reduce)');
  const numeros = [...metricas?.querySelectorAll<HTMLElement>('[data-target]') ?? []];
  const sufijos = [...metricas?.querySelectorAll<HTMLElement>('[data-sufijo]') ?? []];
  const formateador = new Intl.NumberFormat('es-CL');
  function mostrarValoresFinales() {
    numeros.forEach((numero) => { numero.textContent = formateador.format(Number(numero.dataset.target)); });
    sufijos.forEach((sufijo) => { sufijo.hidden = false; });
  }
  if (metricas && !movimientoReducido.matches && 'IntersectionObserver' in window) {
    const observador = new IntersectionObserver((entradas) => {
      if (!entradas.some((entrada) => entrada.isIntersecting)) return;
      observador.disconnect();
      const inicio = performance.now();
      function animarContadores(ahora: number) {
        const progreso = movimientoReducido.matches ? 1 : Math.min((ahora - inicio) / 1000, 1);
        numeros.forEach((numero) => {
          numero.textContent = formateador.format(Math.round(Number(numero.dataset.target) * (1 - (1 - progreso) ** 3)));
        });
        if (progreso < 1) requestAnimationFrame(animarContadores);
        else sufijos.forEach((sufijo) => { sufijo.hidden = false; });
      }
      requestAnimationFrame(animarContadores);
    }, { threshold: .5 });
    observador.observe(metricas);
  } else if (metricas) {
    mostrarValoresFinales();
  }
</script>

<style>
  .hero-metrics { display: grid; grid-template-columns: 1fr 1.42fr .9fr; gap: 16px; margin: 0; padding-top: 23px; border-top: 1px solid var(--borde-destacado); }
  .hero-metric { display: flex; flex-direction: column; min-width: 0; }
  .hero-metric + .hero-metric { border-left: 1px solid var(--borde); padding-left: 17px; }
  dt { font-size: .59rem; font-weight: 600; text-transform: uppercase; letter-spacing: .07em; color: var(--texto-secundario); }
  dd { order: -1; margin: 0 0 8px; color: var(--texto-principal); font-size: clamp(1.9rem, 2.6vw, 2.5rem); font-weight: 600; line-height: 1; letter-spacing: -.055em; font-variant-numeric: tabular-nums; }
  .hero-metric-plus { font-weight: 400; color: var(--acento-portada); margin-left: 2px; }
  .hero-metric-context { order: 1; margin: 7px 0 0; color: var(--texto-secundario); font-size: .6rem; font-weight: 400; letter-spacing: 0; line-height: 1.6; }
  @media (max-width: 991px) { .hero-metrics { gap: 10px; } .hero-metric + .hero-metric { padding-left: 10px; } dd { font-size: 1.85rem; } dt { font-size: .53rem; letter-spacing: .025em; } }
  @media (max-width: 767px) { dd { font-size: clamp(1.85rem, 6.5vw, 2.7rem); } dt { font-size: .56rem; } }
</style>
