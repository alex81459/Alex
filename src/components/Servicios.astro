---
const serviciosPrincipales = [
  {
    icon: 'fa-code',
    title: 'Desarrollo de sistemas',
    summary: 'Frontend, backend, APIs y bases de datos.',
    description: 'Diseño y desarrollo de plataformas web institucionales y empresariales, aplicaciones SPA responsivas y APIs REST seguras. Soluciones modulares orientadas a digitalización, trazabilidad y mejora de procesos.',
    tags: ['Angular', 'React', 'TypeScript', 'Python', 'Flask', 'Nest.js', 'C#'],
  },
  {
    icon: 'fa-exchange',
    title: 'Automatización e integración',
    summary: 'Flujos, interoperabilidad y reducción de tareas manuales.',
    description: 'Integración de plataformas heterogéneas mediante APIs y servicios web. Automatización de tareas repetitivas, digitalización de flujos administrativos y reducción de errores operativos con soluciones a medida.',
    tags: ['APIs REST', 'Interoperabilidad', 'Automatización', 'Docker'],
  },
  {
    icon: 'fa-server',
    title: 'Infraestructura TI',
    summary: 'Servidores, redes, despliegue, seguridad y continuidad.',
    description: 'Administración de servidores Windows y Linux, Active Directory, redes segmentadas, despliegue continuo, monitoreo, respaldos y recuperación ante desastres para infraestructuras distribuidas.',
    tags: ['Windows/Linux', 'Active Directory', 'Redes', 'Backups', 'Continuidad'],
  },
];

const capacidades = [
  {
    icon: 'fa-sitemap',
    title: 'Arquitectura de sistemas',
    description: 'Arquitecturas backend mantenibles y escalables, separación por capas, definición de APIs REST y seguridad desde el diseño, adaptadas a las necesidades del negocio.',
  },
  {
    icon: 'fa-clipboard',
    title: 'Gestión de proyectos',
    description: 'Planificación y ejecución de proyectos TI desde la etapa conceptual hasta producción, incluyendo presupuesto, evaluación SaaS u on-premise y coordinación multidisciplinaria.',
  },
  {
    icon: 'fa-lock',
    title: 'Seguridad informática',
    description: 'Auditoría de sistemas y redes, análisis y mitigación de vulnerabilidades, cifrado, protección de datos sensibles, controles de acceso y destrucción segura de información.',
  },
  {
    icon: 'fa-database',
    title: 'Bases de datos',
    description: 'Modelado relacional, migraciones controladas y optimización de consultas para MySQL, SQL Server y SQLite mediante SQLAlchemy y otras herramientas de persistencia.',
  },
  {
    icon: 'fa-file-text-o',
    title: 'Documentación técnica',
    description: 'Elaboración de documentación especializada, manuales operativos, estándares de procesos TI y antecedentes técnicos para fiscalizaciones y continuidad institucional.',
  },
  {
    icon: 'fa-gavel',
    title: 'Licitaciones tecnológicas',
    description: 'Preparación de bases técnicas, evaluación técnica y económica de ofertas, criterios de aceptación y apoyo formal en procesos de compra pública tecnológica.',
  },
];
---

<section id="services" class="services-section">
  <div class="container services-container">
    <header class="services-heading section-intro text-center">
      <span class="services-eyebrow section-kicker">SOLUCIONES TECNOLÓGICAS</span>
      <h2 class="text-uppercase section-heading">Servicios Informáticos</h2>
      <p class="section-subheading section-lead">Capacidades para diseñar, construir y mantener soluciones tecnológicas de principio a fin.</p>
    </header>

    <div class="services-block-heading">
      <div>
        <span class="services-block-index">01</span>
        <h3>Servicios principales</h3>
      </div>
      <p>Áreas en las que acompaño el ciclo completo de una solución.</p>
    </div>

    <div class="services-primary-grid">
      {serviciosPrincipales.map((servicio, index) => (
        <article class="service-primary-card">
          <div class="service-primary-topline">
            <span class="service-primary-icon" aria-hidden="true"><i class={`fa ${servicio.icon}`}></i></span>
            <span class="service-primary-number">0{index + 1}</span>
          </div>
          <h3>{servicio.title}</h3>
          <p class="service-primary-summary">{servicio.summary}</p>
          <p class="service-primary-description">{servicio.description}</p>
          <div class="service-tags" aria-label="Tecnologías y capacidades relacionadas">
            {servicio.tags.map((tag) => <span>{tag}</span>)}
          </div>
        </article>
      ))}
    </div>

    <div class="services-block-heading services-block-heading-specialized">
      <div>
        <span class="services-block-index">02</span>
        <h3>Capacidades especializadas</h3>
      </div>
      <p>Selecciona una capacidad para consultar su alcance.</p>
    </div>

    <div class="services-capability-grid">
      {capacidades.map((capacidad) => (
        <details class="service-capability-card">
          <summary>
            <span class="service-capability-icon" aria-hidden="true"><i class={`fa ${capacidad.icon}`}></i></span>
            <span>{capacidad.title}</span>
            <i class="fa fa-chevron-down service-capability-chevron" aria-hidden="true"></i>
          </summary>
          <div class="service-capability-content">
            <p>{capacidad.description}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
