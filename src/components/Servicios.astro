---
const serviciosPrincipales = [
  {
    icono: 'fa-code',
    titulo: 'Desarrollo de sistemas',
    resumen: 'Frontend, backend, APIs y bases de datos.',
    descripcion: 'Diseño y desarrollo de plataformas web institucionales y empresariales, aplicaciones SPA responsivas y APIs REST seguras. Soluciones modulares orientadas a digitalización, trazabilidad y mejora de procesos.',
    etiquetas: ['Angular', 'React', 'TypeScript', 'Python', 'Flask', 'Nest.js', 'C#'],
  },
  {
    icono: 'fa-exchange',
    titulo: 'Automatización e integración',
    resumen: 'Flujos, interoperabilidad y reducción de tareas manuales.',
    descripcion: 'Integración de plataformas heterogéneas mediante APIs y servicios web. Automatización de tareas repetitivas, digitalización de flujos administrativos y reducción de errores operativos con soluciones a medida.',
    etiquetas: ['APIs REST', 'Interoperabilidad', 'Automatización', 'Docker'],
  },
  {
    icono: 'fa-server',
    titulo: 'Infraestructura TI',
    resumen: 'Servidores, redes, despliegue, seguridad y continuidad.',
    descripcion: 'Administración de servidores Windows y Linux, Active Directory, redes segmentadas, despliegue continuo, monitoreo, respaldos y recuperación ante desastres para infraestructuras distribuidas.',
    etiquetas: ['Windows/Linux', 'Active Directory', 'Redes', 'Backups', 'Continuidad'],
  },
];

const capacidades = [
  {
    icono: 'fa-sitemap',
    titulo: 'Arquitectura de sistemas',
    descripcion: 'Arquitecturas backend mantenibles y escalables, separación por capas, definición de APIs REST y seguridad desde el diseño, adaptadas a las necesidades del negocio.',
  },
  {
    icono: 'fa-clipboard',
    titulo: 'Gestión de proyectos',
    descripcion: 'Planificación y ejecución de proyectos TI desde la etapa conceptual hasta producción, incluyendo presupuesto, evaluación SaaS u on-premise y coordinación multidisciplinaria.',
  },
  {
    icono: 'fa-lock',
    titulo: 'Seguridad informática',
    descripcion: 'Auditoría de sistemas y redes, análisis y mitigación de vulnerabilidades, cifrado, protección de datos sensibles, controles de acceso y destrucción segura de información.',
  },
  {
    icono: 'fa-database',
    titulo: 'Bases de datos',
    descripcion: 'Modelado relacional, migraciones controladas y optimización de consultas para MySQL, SQL Server y SQLite mediante SQLAlchemy y otras herramientas de persistencia.',
  },
  {
    icono: 'fa-file-text-o',
    titulo: 'Documentación técnica',
    descripcion: 'Elaboración de documentación especializada, manuales operativos, estándares de procesos TI y antecedentes técnicos para fiscalizaciones y continuidad institucional.',
  },
  {
    icono: 'fa-gavel',
    titulo: 'Licitaciones tecnológicas',
    descripcion: 'Preparación de bases técnicas, evaluación técnica y económica de ofertas, criterios de aceptación y apoyo formal en procesos de compra pública tecnológica.',
  },
];
---

<section id="services" class="services-section">
  <div class="container services-container">
    <header class="services-heading section-intro text-center">
      <span class="services-eyebrow section-kicker">SOLUCIONES TECNOLÓGICAS</span>
      <h2 class="text-uppercase section-heading">Servicios Informáticos</h2>
      <p class="section-subheading section-lead">Ingeniero de Software · Full Stack · Infraestructura &amp; DevOps con experiencia en análisis, arquitectura, desarrollo, interoperabilidad, seguridad, despliegue y mantención de sistemas institucionales en operación.</p>
    </header>

    <div class="services-block-heading">
      <div>
        <span class="services-block-index">01</span>
        <h3>Servicios principales</h3>
      </div>
      <p>Áreas en las que acompaño el ciclo completo de una solución.</p>
    </div>

    <div class="services-primary-grid">
      {serviciosPrincipales.map((servicio, indice) => (
        <article class="service-primary-card">
          <div class="service-primary-topline">
            <span class="service-primary-icon" aria-hidden="true"><i class={`fa ${servicio.icono}`}></i></span>
            <span class="service-primary-number">0{indice + 1}</span>
          </div>
          <h3>{servicio.titulo}</h3>
          <p class="service-primary-summary">{servicio.resumen}</p>
          <p class="service-primary-description">{servicio.descripcion}</p>
          <div class="service-tags" aria-label="Tecnologías y capacidades relacionadas">
            {servicio.etiquetas.map((etiqueta) => <span>{etiqueta}</span>)}
          </div>
        </article>
      ))}
    </div>

    <div class="services-block-heading services-block-heading-specialized">
      <div>
        <span class="services-block-index">02</span>
        <h3>Capacidades especializadas</h3>
      </div>
      <p>Selecciona una capacidad para consultar su alcance.</p>
    </div>

    <div class="services-capability-grid">
      {capacidades.map((capacidad) => (
        <details class="service-capability-card">
          <summary>
            <span class="service-capability-icon" aria-hidden="true"><i class={`fa ${capacidad.icono}`}></i></span>
            <span>{capacidad.titulo}</span>
            <i class="fa fa-chevron-down service-capability-chevron" aria-hidden="true"></i>
          </summary>
          <div class="service-capability-content">
            <p>{capacidad.descripcion}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
