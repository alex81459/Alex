---

<section id="certifications" class="certifications-section">
  <div class="container cert-container">
    <header class="cert-heading text-center">
      <span class="cert-eyebrow">FORMACIÓN CONTINUA</span>
      <h2 class="text-uppercase section-heading text-gradient">Certificaciones y Cursos</h2>
      <p class="section-subheading">Seis credenciales especialmente relevantes por su aplicación directa en sistemas en producción, seguridad, operación e interoperabilidad.</p>
    </header>

    <div class="cert-featured-grid" aria-label="Certificaciones destacadas">
      {destacadas.map((certificado) => (
        <article class="cert-featured-card">
          <div class="cert-featured-icon" aria-hidden="true"><i class={`fas ${certificado.icono}`}></i></div>
          <span class="cert-provider">{certificado.institucion}</span>
          <h3>{certificado.titulo}</h3>
          <span class="cert-category-label">{certificado.categoria}</span>
          <p class="cert-evidence cert-evidence-apply"><strong>Aplicación:</strong> {certificado.aplicacion}</p>
        </article>
      ))}
    </div>

    <p class="cert-availability-note">Certificaciones disponibles a solicitud de forma digital.</p>

    <div class="cert-actions">
      <button class="cert-toggle-btn" type="button" id="certToggleBtn" aria-expanded="false" aria-controls="allCertsBlock" onclick="alternarCertificaciones()">
        <i class="fas fa-plus-circle" aria-hidden="true"></i>
        <span>Ver catálogo completo</span>
      </button>
    </div>

    <div id="allCertsBlock" class="cert-catalog" style="display:none;">
      <div class="cert-catalog-header">
        <div>
          <span class="cert-catalog-kicker">CATÁLOGO COMPLETO</span>
          <h3>Explora por área</h3>
        </div>
        <span class="cert-catalog-count">{certificaciones.length} credenciales</span>
      </div>

      <div class="cert-filters" role="group" aria-label="Filtrar certificaciones por área">
        {categorias.map((categoria, indice) => (
          <button class:list={['cert-filter-btn', { active: indice === 0 }]} type="button" data-cert-filter={categoria.identificador} aria-pressed={indice === 0 ? 'true' : 'false'}>
            {categoria.etiqueta}
          </button>
        ))}
      </div>

      <div class="cert-catalog-grid" aria-live="polite">
        {certificaciones.map((certificado) => (
          <article class="cert-catalog-item" data-cert-category={certificado.categoria}>
            <i class="fas fa-check-circle" aria-hidden="true"></i>
            <div>
              <span>{certificado.institucion}</span>
              <h4>{certificado.titulo}</h4>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="cert-summary-strip" aria-label="Resumen de formación">
      <div><strong>6</strong><span>Credenciales destacadas</span></div>
      <div><strong>6</strong><span>Áreas profesionales</span></div>
      <div><strong>10+</strong><span>Años de formación continua</span></div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const botones = document.querySelectorAll<HTMLButtonElement>('[data-cert-filter]');
    const elementos = document.querySelectorAll<HTMLElement>('[data-cert-category]');

    botones.forEach((boton) => {
      boton.addEventListener('click', () => {
        const filtro = boton.dataset.certFilter || 'all';

        botones.forEach((candidato) => {
          const seleccionado = candidato === boton;
          candidato.classList.toggle('active', seleccionado);
          candidato.setAttribute('aria-pressed', String(seleccionado));
        });

        elementos.forEach((elemento) => {
          elemento.hidden = filtro !== 'all' && elemento.dataset.certCategory !== filtro;
        });
      });
    });
  });
</script>
