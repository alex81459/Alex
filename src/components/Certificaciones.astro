  { category: 'sistemas', provider: 'Gobierno Digital', title: 'Transformación Digital con SIMPLE' },
  { category: 'hardware', provider: 'Instituto Conosur', title: 'Armado de Equipos' },
  { category: 'hardware', provider: 'Formación técnica', title: 'Técnico en Reparación de Laptops' },
  { category: 'hardware', provider: 'Formación técnica', title: 'Reparador de Tablets y Teléfonos' },
