  { category: 'desarrollo', provider: 'Udemy', title: 'Angular de Cero a Experto' },
  { category: 'desarrollo', provider: 'Udemy', title: 'Angular Experto' },
  { category: 'desarrollo', provider: 'Udemy', title: 'Node.js Avanzado' },
  { category: 'desarrollo', provider: 'Udemy', title: 'Python Maestro' },
  { category: 'desarrollo', provider: 'Udemy', title: 'Docker' },
  { category: 'desarrollo', provider: 'Udemy', title: 'C# .NET' },
  { category: 'desarrollo', provider: 'Udemy', title: 'Git y GitHub' },
  { category: 'desarrollo', provider: 'Sence', title: 'WordPress 5' },
  { category: 'desarrollo', provider: 'Udemy', title: 'MySQL y MariaDB' },
  { category: 'seguridad', provider: 'Cisco', title: 'Cybersecurity Essentials' },
  { category: 'seguridad', provider: 'Udemy', title: 'Seguridad Informática y Hacking' },
  { category: 'seguridad', provider: 'Google', title: 'Protege tu Negocio: Ciberseguridad' },
  { category: 'seguridad', provider: 'Platzi', title: 'Seguridad Informática para Empresas' },
  { category: 'seguridad', provider: 'Formación profesional', title: 'Análisis de Riesgos de Seguridad Informática' },
