---

<section id="certifications" class="certifications-section">
  <div class="container cert-container">
    <header class="cert-heading text-center">
      <span class="cert-eyebrow">FORMACIÓN CONTINUA</span>
      <h2 class="text-uppercase section-heading text-gradient">Certificaciones y Cursos</h2>
      <p class="section-subheading">Una selección de formación aplicada en desarrollo, infraestructura, seguridad y gestión.</p>
    </header>

    <div class="cert-featured-grid" aria-label="Certificaciones destacadas">
      {destacadas.map((cert) => (
        <article class="cert-featured-card">
          <div class="cert-featured-icon" aria-hidden="true"><i class={`fas ${cert.icon}`}></i></div>
          <span class="cert-provider">{cert.provider}</span>
          <h3>{cert.title}</h3>
          <span class="cert-category-label">{cert.category}</span>
        </article>
      ))}
    </div>

    <div class="cert-actions">
      <button class="cert-toggle-btn" type="button" id="certToggleBtn" aria-expanded="false" aria-controls="allCertsBlock" onclick="toggleAllCerts()">
        <i class="fas fa-plus-circle" aria-hidden="true"></i>
        <span>Ver las 30+ certificaciones</span>
      </button>
    </div>

    <div id="allCertsBlock" class="cert-catalog" style="display:none;">
      <div class="cert-catalog-header">
        <div>
          <span class="cert-catalog-kicker">CATÁLOGO COMPLETO</span>
          <h3>Explora por área</h3>
        </div>
        <span class="cert-catalog-count">{certificaciones.length} credenciales</span>
      </div>

      <div class="cert-filters" role="group" aria-label="Filtrar certificaciones por área">
        {categorias.map((categoria, index) => (
          <button class:list={['cert-filter-btn', { active: index === 0 }]} type="button" data-cert-filter={categoria.id} aria-pressed={index === 0 ? 'true' : 'false'}>
            {categoria.label}
          </button>
        ))}
      </div>

      <div class="cert-catalog-grid" aria-live="polite">
        {certificaciones.map((cert) => (
          <article class="cert-catalog-item" data-cert-category={cert.category}>
            <i class="fas fa-check-circle" aria-hidden="true"></i>
            <div>
              <span>{cert.provider}</span>
              <h4>{cert.title}</h4>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="cert-summary-strip" aria-label="Resumen de formación">
      <div><strong>30+</strong><span>Certificaciones</span></div>
      <div><strong>6</strong><span>Áreas profesionales</span></div>
      <div><strong>10+</strong><span>Años formándose</span></div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-cert-filter]');
    const items = document.querySelectorAll<HTMLElement>('[data-cert-category]');

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.dataset.certFilter || 'all';

        buttons.forEach((candidate) => {
          const selected = candidate === button;
          candidate.classList.toggle('active', selected);
          candidate.setAttribute('aria-pressed', String(selected));
        });

        items.forEach((item) => {
          item.hidden = filter !== 'all' && item.dataset.certCategory !== filter;
        });
      });
    });
  });
</script>
