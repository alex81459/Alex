---
const ecosistema = [
  {
    icono: 'fa-desktop',
    titulo: 'Frontend',
    descripcion: 'Interfaces administrativas responsivas y orientadas a flujos complejos.',
    tecnologias: [
      { nombre: 'Angular + PrimeNG 22', experiencia: 'Uso principal · Producción', proyectos: 'Libro de Clases en producción, portales y paneles administrativos' },
      { nombre: 'TypeScript', experiencia: 'Uso principal · Producción', proyectos: 'Aplicaciones SPA, formularios y servicios frontend' },
      { nombre: 'Componentes UI y tablas', experiencia: 'Uso frecuente · Producción', proyectos: 'PrimeNG 22, tablas, dashboards y componentes institucionales' },
      { nombre: 'React y ecosistema UI', experiencia: 'Experiencia aplicada', proyectos: 'React, Tailwind, Bootstrap, HTML5, CSS3 y SCSS' },
    ],
  },
  {
    icono: 'fa-code',
    titulo: 'Backend',
    descripcion: 'Servicios seguros, integración de sistemas y lógica de negocio mantenible.',
    tecnologias: [
      { nombre: 'Python / Flask', experiencia: 'Uso principal · Producción', proyectos: 'SIMPLE, APIs institucionales, interoperabilidad y automatizaciones' },
      { nombre: 'Node.js / NestJS', experiencia: 'Uso frecuente · Producción', proyectos: 'Servicios REST, integraciones y procesos en tiempo real' },
      { nombre: 'C# / .NET', experiencia: 'Experiencia aplicada · Producción', proyectos: 'Minimal APIs, automatización industrial y aplicaciones empresariales' },
      { nombre: 'APIs y mensajería', experiencia: 'Uso transversal', proyectos: 'REST, Swagger/OpenAPI, WebSockets, Socket.IO, SendGrid y Nodemailer' },
    ],
  },
  {
    icono: 'fa-database',
    titulo: 'Datos',
    descripcion: 'Modelado relacional, persistencia y explotación de información operativa.',
    tecnologias: [
      { nombre: 'MySQL', experiencia: 'Uso principal · Producción', proyectos: 'Sistemas institucionales, trazabilidad y portales web' },
      { nombre: 'SQL Server', experiencia: 'Uso frecuente · Producción', proyectos: 'Aplicaciones empresariales e integración de datos' },
      { nombre: 'SQLAlchemy', experiencia: 'Uso principal · Producción', proyectos: 'Modelos, migraciones y consultas en plataformas Flask' },
      { nombre: 'Reportes e integraciones', experiencia: 'Uso transversal', proyectos: 'SQLite, Google Sheets API, Excel/XLSX, PDFMake, jsPDF y Chart.js' },
    ],
  },
  {
    icono: 'fa-server',
    titulo: 'Infraestructura',
    descripcion: 'Despliegue, observabilidad y continuidad de plataformas en producción.',
    tecnologias: [
      { nombre: 'Docker', experiencia: 'Uso principal · Producción', proyectos: 'Contenedores de aplicaciones, APIs y servicios institucionales' },
      { nombre: 'Nginx', experiencia: 'Uso principal · Producción', proyectos: 'Proxy inverso, publicación segura y entrega de aplicaciones' },
      { nombre: 'Linux', experiencia: 'Administración · Producción', proyectos: 'Servidores, Bash, monitoreo y continuidad operativa' },
      { nombre: 'Operación y despliegue', experiencia: 'Experiencia aplicada', proyectos: 'GitHub Actions, Kubernetes, Sentry, Windows Server, redes y conectividad' },
    ],
  },
];
function obtenerIconoTecnologia(nombre: string) {
  const iconos: Record<string, string> = {
    'Angular + PrimeNG 22': 'fab fa-angular', TypeScript: 'fa fa-code', 'Componentes UI y tablas': 'fa fa-th-large', 'React y ecosistema UI': 'fab fa-react',
    'Python / Flask': 'fab fa-python', 'Node.js / NestJS': 'fab fa-node-js', 'C# / .NET': 'fa fa-code', 'APIs y mensajería': 'fa fa-exchange',
    MySQL: 'fa fa-database', 'SQL Server': 'fa fa-database', SQLAlchemy: 'fa fa-sitemap', 'Reportes e integraciones': 'fa fa-bar-chart',
    Docker: 'fab fa-docker', Nginx: 'fa fa-server', Linux: 'fab fa-linux', 'Operación y despliegue': 'fa fa-cogs',
  };
  return iconos[nombre] ?? 'fa fa-code';
}

---

<section id="tech-stack" class="tech-stack-section">
  <div class="container tech-ecosystem-container">
    <header class="tech-ecosystem-heading text-center">
      <span class="tech-ecosystem-eyebrow">ECOSISTEMA TECNOLÓGICO</span>
      <h2 class="text-uppercase section-heading text-gradient">Stack Tecnológico</h2>
      <p class="section-subheading">Tecnologías utilizadas en soluciones reales, organizadas según el lugar que ocupan dentro de la arquitectura.</p>
    </header>

    <div class="tech-ecosystem-grid">
      {ecosistema.map((grupo, indice) => (
        <article class="tech-domain-card" data-tech-domain>
          <header class="tech-domain-header">
            <div class="tech-domain-icon" aria-hidden="true"><i class={`fa ${grupo.icono}`}></i></div>
            <div>
              <span class="tech-domain-index">0{indice + 1}</span>
              <h3>{grupo.titulo}</h3>
            </div>
          </header>
          <p class="tech-domain-description">{grupo.descripcion}</p>

          <div class="tech-experience-list">
            {grupo.tecnologias.map((tecnologia) => (
              <div class="tech-experience-item" data-tech-item data-nombre={tecnologia.nombre} data-experiencia={tecnologia.experiencia} data-proyectos={tecnologia.proyectos} tabindex="0" role="button" aria-pressed="false">
                <div class="tech-experience-title">
                  <span class="tech-experience-logo" aria-hidden="true"><i class={obtenerIconoTecnologia(tecnologia.nombre)}></i></span>
                  <h4>{tecnologia.nombre}</h4>
                </div>
                <span class="tech-experience-meta">{tecnologia.experiencia}</span>
                <p>{tecnologia.proyectos}</p>
              </div>
            ))}
          </div>
          <div class="tech-context" aria-live="polite">
            <span class="tech-context-label">TECNOLOGÍA SELECCIONADA</span>
            <strong data-tech-context-name>{grupo.tecnologias[0].nombre}</strong>
            <span data-tech-context-experience>{grupo.tecnologias[0].experiencia}</span>
            <p>Utilizado en:</p>
            <ul data-tech-context-projects>{grupo.tecnologias[0].proyectos.split(', ').map((proyecto) => <li>{proyecto}</li>)}</ul>
          </div>
        </article>
      ))}
    </div>

    <div class="tech-ecosystem-note">
      <i class="fa fa-puzzle-piece" aria-hidden="true"></i>
      <p><strong>Integración transversal:</strong> autenticación y control de acceso, documentación técnica, Google APIs, Mapbox, reportes PDF/Excel y despliegue continuo se incorporan según las necesidades de cada solución.</p>
    </div>
  </div>
</section>
<script>
  const dominiosTecnologicos = [...document.querySelectorAll<HTMLElement>('[data-tech-domain]')];
  function actualizarContextoTecnologia(elemento: HTMLElement) {
    const dominio = elemento.closest<HTMLElement>('[data-tech-domain]');
    if (!dominio) return;
    const elementos = [...dominio.querySelectorAll<HTMLElement>('[data-tech-item]')];
    elementos.forEach((tecnologia) => tecnologia.setAttribute('aria-pressed', String(tecnologia === elemento)));
    const nombre = dominio.querySelector<HTMLElement>('[data-tech-context-name]');
    const experiencia = dominio.querySelector<HTMLElement>('[data-tech-context-experience]');
    const proyectos = dominio.querySelector<HTMLUListElement>('[data-tech-context-projects]');
    if (nombre) nombre.textContent = elemento.dataset.nombre ?? '';
    if (experiencia) experiencia.textContent = elemento.dataset.experiencia ?? '';
    if (proyectos) {
      proyectos.replaceChildren(...(elemento.dataset.proyectos ?? '').split(', ').map((proyecto) => { const elementoLista = document.createElement('li'); elementoLista.textContent = proyecto; return elementoLista; }));
    }
  }
  dominiosTecnologicos.forEach((dominio) => {
    const tecnologias = [...dominio.querySelectorAll<HTMLElement>('[data-tech-item]')];
    tecnologias.forEach((tecnologia) => {
      tecnologia.addEventListener('pointerenter', () => actualizarContextoTecnologia(tecnologia));
      tecnologia.addEventListener('focus', () => actualizarContextoTecnologia(tecnologia));
      tecnologia.addEventListener('click', () => actualizarContextoTecnologia(tecnologia));
      tecnologia.addEventListener('keydown', (evento) => { if (evento.key === 'Enter' || evento.key === ' ') { evento.preventDefault(); actualizarContextoTecnologia(tecnologia); } });
    });
  });
</script>

<style>
  .tech-experience-item { width: 100%; text-align: left; color: inherit; cursor: pointer; }
  .tech-experience-item[aria-pressed='true'] { border-color: color-mix(in srgb, var(--primario) 55%, transparent); background: var(--primario-suave); }
  .tech-experience-logo { display: grid; place-items: center; width: 25px; height: 25px; border-radius: 7px; color: var(--primario); background: color-mix(in srgb, var(--primario) 12%, transparent); transition: transform .22s ease, color .22s ease, background .22s ease; }
  .tech-experience-logo i { font-size: .82rem; }
  .tech-experience-item:hover .tech-experience-logo, .tech-experience-item[aria-pressed='true'] .tech-experience-logo { color: var(--texto-principal); background: var(--primario); transform: rotate(-6deg) scale(1.08); }
  .tech-experience-title h4 { margin: 0; }
  .tech-context { margin-top: 12px; padding: 13px 15px; border: 1px solid color-mix(in srgb, var(--primario) 25%, transparent); border-radius: var(--radio-medio); background: color-mix(in srgb, var(--primario-suave) 38%, transparent); }
  .tech-context-label { display: block; color: var(--texto-secundario); font: .53rem ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: .08em; }
  .tech-context strong { display: block; margin-top: 5px; color: var(--texto-principal); font-size: .87rem; }
  .tech-context > span:not(.tech-context-label) { display: block; margin-top: 3px; color: var(--primario); font-size: .66rem; font-weight: 700; }
  .tech-context p { margin: 10px 0 3px; color: var(--texto-secundario); font-size: .68rem; }
  .tech-context ul { margin: 0; padding-left: 17px; color: var(--texto-principal); font-size: .7rem; line-height: 1.55; }
  @media (prefers-reduced-motion: reduce) { .tech-experience-logo { transition: none; } .tech-experience-item:hover .tech-experience-logo, .tech-experience-item[aria-pressed='true'] .tech-experience-logo { transform: none; } }
</style>
