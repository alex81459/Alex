---
const nodos = [
  { identificador: 'frontend', nombre: 'Angular · React · Astro · Next.js', tecnologias: ['Angular', 'React', 'Astro', 'Next.js'], capa: 'INTERFAZ', icono: 'fas fa-laptop-code', estado: 'CONECTADO', descripcion: 'Interfaces administrativas con Angular y React, plataformas con Next.js y sitios estáticos con Astro, como este portafolio.', proyecto: 'Libro de Clases Digital', enlace: '#portfolioModal9' },
  { identificador: 'api', nombre: 'API REST · Microservicios', capa: 'INTEGRACIÓN', icono: 'fas fa-exchange-alt', estado: 'RESPUESTA 200', descripcion: 'Contratos REST, autenticación e interoperabilidad entre plataformas institucionales.', proyecto: 'Trámites Online · SIMPLE', enlace: '#portfolioModal10' },
  { identificador: 'backend', nombre: 'Flask · NestJS · .NET Core · Prisma', tecnologias: ['Flask', 'NestJS', '.NET Core', 'Prisma'], capa: 'SERVIDOR', icono: 'fas fa-layer-group', estado: 'OPERATIVO', descripcion: 'APIs y lógica de negocio con Flask, NestJS y .NET Core; acceso a datos con Prisma. NestJS y Prisma forman parte del Portal de Consejos Escolares.', proyecto: 'Portal de Consejos Escolares', enlace: '#portfolioModal13' },
  { identificador: 'database', nombre: 'MySQL · MariaDB · SqlServer', capa: 'DATOS', icono: 'fas fa-database', estado: 'CONECTADO', descripcion: 'Modelado de datos, persistencia y consultas para plataformas institucionales.', proyecto: 'Libro de Clases Digital', enlace: '#portfolioModal9' },
  { identificador: 'docker', nombre: 'Docker · Kubernetes', capa: 'CONTENEDORES', icono: 'fab fa-docker', estado: 'EN EJECUCIÓN', descripcion: 'Servicios empaquetados en contenedores y desplegados en infraestructura productiva.', proyecto: 'Portal de Consejos Escolares', enlace: '#portfolioModal13' },
  { identificador: 'nginx', nombre: 'Nginx · Servidor Linux', capa: 'DESPLIEGUE', icono: 'fas fa-server', estado: 'EN LÍNEA', descripcion: 'Proxy inverso y exposición de servicios sobre servidores Linux, con operación y mantenimiento continuo.', proyecto: 'Portal de Consejos Escolares', enlace: '#portfolioModal13' },
];
const seleccionado = nodos[2];
// Dos recorridos independientes por enlace, con puertos propios en cada extremo.
const conexiones = [
  { envio: 'M205 45H255', recepcion: 'M205 53H255', puertosEnvio: [[205, 45], [255, 45]], puertosRecepcion: [[205, 53], [255, 53]] },
  { envio: 'M361.5 98V116H106.5V126', recepcion: 'M353.5 98V108H98.5V126', puertosEnvio: [[361.5, 98], [106.5, 126]], puertosRecepcion: [[353.5, 98], [98.5, 126]] },
  { envio: 'M205 171H255', recepcion: 'M205 179H255', puertosEnvio: [[205, 171], [255, 171]], puertosRecepcion: [[205, 179], [255, 179]] },
  { envio: 'M98.5 224V252', recepcion: 'M106.5 224V252', puertosEnvio: [[98.5, 224], [98.5, 252]], puertosRecepcion: [[106.5, 224], [106.5, 252]] },
  { envio: 'M205 297H255', recepcion: 'M205 305H255', puertosEnvio: [[205, 297], [255, 297]], puertosRecepcion: [[205, 305], [255, 305]] },
];
---

<figure class="system-map" aria-labelledby="system-map-title" data-system-map>
  <div class="system-map-heading">
    <div>
      <p class="system-map-kicker"><span aria-hidden="true">01 /</span> ARQUITECTURA DE REFERENCIA</p>
      <h2 id="system-map-title">Del código a producción<span>.</span></h2>
    </div>
    <span class="system-map-symbol" aria-hidden="true"><i class="fas fa-project-diagram"></i></span>
  </div>

  <div class="system-map-surface">
    <div class="system-map-legend" aria-hidden="true"><span>APLICACIONES</span><span>INFRAESTRUCTURA</span></div>
    <div class="system-nodes" role="group" aria-label="Componentes de la arquitectura; selecciona uno para ver su aplicación">
      <svg class="system-connections" viewBox="0 0 460 350" preserveAspectRatio="none" fill="none" aria-hidden="true">
        {conexiones.map((conexion, indice) => (
          <g>
            <path d={conexion.envio} class="connection-track" />
            <path d={conexion.recepcion} class="connection-track connection-track-return" />
            <path d={conexion.envio} pathLength="100" class="connection-flow" style={`--retardo-flujo: ${indice * -.6}s`} />
            <path d={conexion.recepcion} pathLength="100" class="connection-flow connection-flow-return" style={`--retardo-flujo: ${indice * -.6 - 1.8}s`} />
            {conexion.puertosEnvio.map(([centroX, centroY]) => <circle cx={centroX} cy={centroY} r="2" class="connection-port" />)}
            {conexion.puertosRecepcion.map(([centroX, centroY]) => <circle cx={centroX} cy={centroY} r="2" class="connection-port connection-port-return" />)}
          </g>
        ))}
      </svg>
      {nodos.map((nodo, indice) => (
        <button type="button" class="system-node" data-node={nodo.identificador} data-description={nodo.descripcion} data-project={nodo.proyecto} data-href={nodo.enlace} aria-pressed={nodo.identificador === seleccionado.identificador ? 'true' : 'false'} aria-controls="system-node-detail" aria-describedby={`system-description-${nodo.identificador}`} style={`--orden-nodo: ${indice}`}>
          <span class="system-node-icon" aria-hidden="true"><i class={nodo.icono}></i></span>
          <span class="system-node-copy">
            <span class="system-node-layer">{nodo.capa}</span>
            <strong class:list={{ 'system-node-technologies': nodo.tecnologias }}>
              {nodo.tecnologias ? nodo.tecnologias.map((tecnologia) => <span>{tecnologia}</span>) : nodo.nombre}
            </strong>
            <span class="system-node-state"><span aria-hidden="true"></span>{nodo.estado}</span>
          </span>
          <svg class="system-mobile-connection" viewBox="0 0 16 20" fill="none" aria-hidden="true" style={`--retardo-flujo: ${indice * -.6}s`}>
            <path d="M4 0V20" class="connection-track" />
            <path d="M12 0V20" class="connection-track connection-track-return" />
            <path d="M4 0V20" pathLength="100" class="connection-flow" />
            <path d="M12 0V20" pathLength="100" class="connection-flow connection-flow-return" />
            {[0, 20].map((centroY) => (
              <>
                <circle cx="4" cy={centroY} r="2" class="connection-port" />
                <circle cx="12" cy={centroY} r="2" class="connection-port connection-port-return" />
              </>
            ))}
          </svg>
          <span class="visually-hidden" id={`system-description-${nodo.identificador}`}>{nodo.descripcion}</span>
        </button>
      ))}
    </div>
    <div class="system-production">
      <svg class="system-production-connection" viewBox="0 0 16 23" fill="none" aria-hidden="true">
        <path d="M4 0V23" class="connection-track" />
        <path d="M12 0V23" class="connection-track connection-track-return" />
        <path d="M4 0V23" pathLength="100" class="connection-flow" />
        <path d="M12 0V23" pathLength="100" class="connection-flow connection-flow-return" />
        {[0, 23].map((centroY) => (
          <>
            <circle cx="4" cy={centroY} r="2" class="connection-port" />
            <circle cx="12" cy={centroY} r="2" class="connection-port connection-port-return" />
          </>
        ))}
      </svg>
      <span class="production-icon" aria-hidden="true"><i class="fas fa-check"></i></span>
      <span><strong>Producción</strong><small>Servidor Linux · Operación Continua · Accesible Mediante Internet o Red Interna</small></span>
      <span class="production-state">DESPLEGADO <span aria-hidden="true">✓</span></span>
    </div>
  </div>

  <div id="system-node-detail" class="system-node-detail">
    <span class="system-detail-label">APLICADO EN PROYECTOS REALES <span aria-hidden="true">↗︎</span></span>
    <p data-node-description>{seleccionado.descripcion}</p>
    <a href={seleccionado.enlace} data-bs-toggle="modal" data-node-project>{seleccionado.proyecto}<span aria-hidden="true"> →</span></a>
  </div>
  <figcaption>
    <span class="system-flow-legend"><span class="flow-label-send">Envío →</span><span class="flow-label-receive">← Recepción</span><span>Estados ilustrativos</span></span>
    <button class="system-flow-toggle" type="button" aria-pressed="false" hidden>Pausar flujo</button>
  </figcaption>
</figure>

<script>
  const diagrama = document.querySelector<HTMLElement>('[data-system-map]');
  if (diagrama) {
    const botonFlujo = diagrama.querySelector<HTMLButtonElement>('.system-flow-toggle');
    let flujoPausado = false;
    let diagramaVisible = true;
    function actualizarFlujo() {
      diagrama?.setAttribute('data-flow-paused', String(flujoPausado || !diagramaVisible || document.hidden));
    }
    if (botonFlujo) {
      botonFlujo.hidden = false;
      botonFlujo.addEventListener('click', () => {
        flujoPausado = !flujoPausado;
        botonFlujo.setAttribute('aria-pressed', String(flujoPausado));
        botonFlujo.textContent = flujoPausado ? 'Reanudar flujo' : 'Pausar flujo';
        actualizarFlujo();
      });
    }
    if ('IntersectionObserver' in window) {
      const observador = new IntersectionObserver(([entrada]) => {
        diagramaVisible = entrada.isIntersecting;
        actualizarFlujo();
      });
      observador.observe(diagrama);
    }
    document.addEventListener('visibilitychange', actualizarFlujo);
    const nodos = [...diagrama.querySelectorAll<HTMLButtonElement>('[data-node]')];
    const descripcion = diagrama.querySelector<HTMLElement>('[data-node-description]');
    const proyecto = diagrama.querySelector<HTMLAnchorElement>('[data-node-project]');
    function seleccionarNodo(nodo: HTMLButtonElement) {
      nodos.forEach((elemento) => elemento.setAttribute('aria-pressed', String(elemento === nodo)));
      if (descripcion) descripcion.textContent = nodo.dataset.description ?? '';
      if (proyecto) {
        proyecto.textContent = `${nodo.dataset.project} →`;
        proyecto.setAttribute('href', nodo.dataset.href ?? '#portfolio');
      }
    }
    nodos.forEach((nodo) => {
      nodo.addEventListener('pointerenter', (evento) => {
        if (evento.pointerType === 'mouse' && !nodos.some((elemento) => elemento === document.activeElement)) seleccionarNodo(nodo);
      });
      nodo.addEventListener('focus', () => seleccionarNodo(nodo));
      nodo.addEventListener('click', () => seleccionarNodo(nodo));
      nodo.addEventListener('keydown', (evento) => {
        if (!['ArrowRight', 'ArrowDown', 'ArrowLeft', 'ArrowUp', 'Home', 'End'].includes(evento.key)) return;
        evento.preventDefault();
        const paso = evento.key === 'ArrowRight' || evento.key === 'ArrowDown' ? 1 : -1;
        const indice = evento.key === 'Home' ? 0 : evento.key === 'End' ? nodos.length - 1 : (nodos.indexOf(nodo) + paso + nodos.length) % nodos.length;
        nodos[indice].focus();
      });
    });
  }
</script>

<style>
  .system-map { --acento-diagrama: #82d3f7; --recepcion-diagrama: #b9abf6; --exito-diagrama: #85cbb4; margin: 0; min-width: 0; width: 100%; color: var(--texto-principal); }
  .system-map-heading { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 20px; }
  .system-map-kicker { color: var(--texto-secundario); font-size: .58rem; font-weight: 500; letter-spacing: .13em; margin: 0 0 9px; }
  .system-map-kicker > span { color: var(--acento-diagrama); margin-right: 8px; }
  h2 { margin: 0; color: var(--texto-principal); font-size: clamp(1.15rem, 1.6vw, 1.45rem); font-weight: 500; letter-spacing: -.04em; }
  h2 > span { color: var(--acento-diagrama); }
  .system-map-symbol { font-size: 1.15rem; color: var(--texto-tenue); }
  .system-map-surface { position: relative; padding: 16px; border: 1px solid var(--borde-destacado); border-radius: var(--radio-superficie); background: color-mix(in srgb, var(--fondo-tarjeta) 45%, var(--fondo-principal)); box-shadow: var(--sombra-superficie); }
  .system-map-legend { display: flex; justify-content: space-between; margin-bottom: 14px; color: var(--texto-secundario); font: .52rem ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: .13em; }
  .system-nodes { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); grid-auto-rows: 98px; column-gap: 10.87%; row-gap: 28px; }
  .system-connections { position: absolute; inset: 0; z-index: 2; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .connection-track { stroke: var(--acento-diagrama); stroke-opacity: .25; stroke-width: 1; }
  .connection-track-return { stroke: var(--recepcion-diagrama); }
  .connection-port { fill: var(--fondo-tarjeta); stroke: var(--acento-diagrama); stroke-width: 1; }
  .connection-port-return { stroke: var(--recepcion-diagrama); }
  .connection-flow { stroke: var(--acento-diagrama); stroke-width: 2; stroke-linecap: round; stroke-dasharray: 10 90; animation: connection-flow 3.6s var(--retardo-flujo, 0s) linear infinite; }
  .connection-flow-return { stroke: var(--recepcion-diagrama); stroke-dasharray: 6 94; animation-direction: reverse; }
  .system-map[data-flow-paused='true'] .connection-flow { animation-play-state: paused; }
  .system-mobile-connection { display: none; }
  .system-node { position: relative; display: flex; align-items: center; gap: 12px; min-width: 0; padding: 12px; border: 1px solid var(--borde-destacado); border-radius: var(--radio-medio); background: var(--fondo-tarjeta); text-align: left; color: var(--texto-principal); cursor: pointer; transition: border-color .2s, background .2s, transform .2s; animation: node-enter .6s calc(var(--orden-nodo) * .07s + .2s) backwards; }
  .system-node:hover, .system-node[aria-pressed='true'] { border-color: var(--acento-diagrama); background: color-mix(in srgb, var(--primario-suave) 30%, var(--fondo-tarjeta)); }
  .system-node:hover { transform: none; }
  .system-node-icon { flex: 0 0 30px; display: grid; place-items: center; width: 30px; height: 34px; border-radius: var(--radio-control); color: var(--acento-diagrama); background: var(--primario-suave); font-size: 1.12rem; }
  [data-node='frontend'] .system-node-icon { color: #f28fae; background: #d8497714; }
  [data-node='backend'] .system-node-icon { color: #b9abf6; background: #8b5cf614; }
  .system-node-copy { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .system-node-layer { color: var(--texto-secundario); font: .5rem ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: .08em; }
  .system-node strong { font-size: clamp(.68rem, 1vw, .87rem); font-weight: 600; }
  .system-node .system-node-technologies { display: flex; flex-wrap: wrap; gap: 3px 8px; font-size: clamp(.61rem, .85vw, .78rem); line-height: 1.5; }
  .system-node-technologies > span { white-space: nowrap; }
  .system-node-state { display: flex; align-items: center; gap: 5px; color: var(--texto-secundario); font: .49rem ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: .03em; }
  .system-node-state > span { width: 4px; height: 4px; border-radius: 50%; background: var(--acento-diagrama); }
  .system-production { position: relative; display: flex; align-items: center; gap: 12px; margin-top: 23px; padding: 11px 14px; background: color-mix(in srgb, var(--exito-diagrama) 5%, var(--fondo-principal)); border: 1px solid color-mix(in srgb, var(--exito-diagrama) 28%, transparent); border-radius: var(--radio-medio); }
  .system-production-connection { position: absolute; right: calc(21% - 8px); top: -24px; height: 23px; width: 16px; overflow: visible; pointer-events: none; }
  .production-icon { color: var(--exito-diagrama); font-size: .75rem; }
  .system-production strong { display: block; font-size: .82rem; font-weight: 600; }
  .system-production small { display: block; color: var(--texto-secundario); font-size: .6rem; margin-top: 3px; }
  .production-state { margin-left: auto; color: var(--exito-diagrama); font: .52rem ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: .04em; }
  .system-node-detail { margin-top: 16px; padding: 0 2px 0 13px; border-left: 2px solid var(--acento-diagrama); min-height: 84px; }
  .system-detail-label { display: flex; justify-content: space-between; color: var(--texto-secundario); font-size: .53rem; font-weight: 500; letter-spacing: .1em; }
  .system-detail-label > span { color: var(--acento-diagrama); }
  .system-node-detail p { margin: 7px 0 4px; color: var(--texto-secundario); font-size: .72rem; line-height: 1.65; }
  .system-node-detail a { display: inline-flex; align-items: center; min-height: 28px; color: var(--acento-diagrama); font-size: .7rem; text-decoration: none; }
  .system-node-detail a:hover { text-decoration: underline; text-underline-offset: 4px; }
  figcaption { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6px 12px; margin-top: 10px; color: var(--texto-secundario); font-size: .56rem; }
  .system-flow-legend { display: inline-flex; flex-wrap: wrap; gap: 6px 12px; }
  .flow-label-send { color: var(--acento-diagrama); }
  .flow-label-receive { color: var(--recepcion-diagrama); }
  .system-flow-toggle { min-height: 28px; padding: 4px 8px; color: var(--texto-secundario); background: transparent; border: 1px solid var(--borde-destacado); border-radius: var(--radio-control); font-size: .6rem; }
  .system-flow-toggle:hover { color: var(--acento-diagrama); border-color: currentColor; }
  .system-flow-toggle[hidden] { display: none; }
  :global(html[data-theme='light']) .system-map { --acento-diagrama: #096aaa; --recepcion-diagrama: #7850c0; --exito-diagrama: #21765d; }
  :global(html[data-theme='light']) [data-node='frontend'] .system-node-icon { color: #ba2759; }
  :global(html[data-theme='light']) [data-node='backend'] .system-node-icon { color: #7850c0; }
  @keyframes connection-flow { from { stroke-dashoffset: 100; } to { stroke-dashoffset: 0; } }
  @keyframes node-enter { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @media (min-width: 768px) and (max-width: 1099px) { .system-map-surface { padding: 14px; } .system-node { flex-direction: column; align-items: flex-start; justify-content: center; gap: 4px; padding: 8px 10px; } .system-node-icon { position: absolute; right: 7px; top: 8px; width: 20px; height: 20px; font-size: .8rem; } .system-node-layer { max-width: calc(100% - 16px); font-size: .45rem; } .system-map-kicker { font-size: .48rem; } .system-node-detail { min-height: 112px; } .production-state { font-size: .46rem; } }
  @media (max-width: 767px) {
    .system-map { max-width: 540px; }
    .system-map-heading { margin-bottom: 18px; }
    .system-map-surface { padding: 18px; }
    .system-map-legend, .system-connections { display: none; }
    .system-nodes { grid-template-columns: minmax(0, 1fr); grid-auto-rows: minmax(64px, auto); gap: 20px; }
    .system-node { padding: 10px 14px; gap: 14px; }
    .system-node-copy { flex: 1; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2px 8px; align-items: center; }
    .system-node-layer { grid-column: 1; font-size: .5rem; }
    .system-node strong { grid-column: 1; font-size: .85rem; }
    .system-node-state { grid-column: 2; grid-row: 1 / 3; font-size: .46rem; }
    .system-mobile-connection { display: block; position: absolute; left: 22px; bottom: -21px; height: 20px; width: 16px; overflow: visible; pointer-events: none; }
    .system-production { margin-top: 20px; padding-inline: 15px; }
    .system-production-connection { display: none; }
    .system-node-detail { min-height: 107px; }
    figcaption { font-size: .55rem; }
  }
  @media (prefers-reduced-motion: reduce) { .connection-flow { animation: none; opacity: 0; } .system-flow-toggle { display: none; } .system-node { animation: none; transition: none; } .system-node:hover { transform: none; } }
</style>
