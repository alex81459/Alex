---
import Arquitectura from './Arquitectura.astro';
import MetricasPortada from './StatsBand.astro';
const rutaBase = import.meta.env.BASE_URL;
---

<header class="engineering-hero" aria-labelledby="hero-title">
  <div class="container engineering-hero-layout">
    <div class="engineering-hero-copy">
      <p class="hero-identity hero-enter">Alex Salinas Ponce <span>· Chile</span></p>
      <p class="hero-eyebrow hero-enter"><span aria-hidden="true"></span> INGENIERO DE SOFTWARE</p>
      <h1 id="hero-title" class="hero-enter">Construyo sistemas<br class="hero-desktop-break" /> que llegan a <span>producción.</span></h1>
      <p class="hero-description hero-enter">Desarrollo software, APIs e infraestructura para transformar procesos reales en plataformas digitales escalables.</p>
      <p class="hero-disciplines hero-enter">Desarrollo integral <span>·</span> APIs <span>·</span> Infraestructura <span>·</span> DevOps</p>
      <div class="hero-actions hero-enter">
        <a class="hero-action hero-action-primary js-scroll-trigger" href="#portfolio">Explorar proyectos <i class="fa fa-arrow-right" aria-hidden="true"></i></a>
        <a class="hero-action hero-action-secondary" href={`${rutaBase}assets/curriculum-v3-2026.pdf`} download><i class="fa fa-download" aria-hidden="true"></i> Descargar CV</a>
      </div>
      <div class="hero-connections hero-enter">
        <a href="https://github.com/alex81459" target="_blank" rel="noopener noreferrer" aria-label="GitHub de Alex Salinas (abre otra pestaña)"><i class="fab fa-github" aria-hidden="true"></i> GitHub <span aria-hidden="true">↗︎</span></a>
        <a href="https://www.linkedin.com/in/alex-salinas-ponce-5276691a3" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn de Alex Salinas (abre otra pestaña)"><i class="fab fa-linkedin-in" aria-hidden="true"></i> LinkedIn <span aria-hidden="true">↗︎</span></a>
        <span class="hero-experience">Experiencia TI desde 2019</span>
      </div>
      <MetricasPortada />
    </div>
    <Arquitectura />
    <div class="hero-bottom">
      <p><span aria-hidden="true">↳</span> Diseño. Desarrollo. Integro. Despliego. Mantengo.</p>
      <a class="js-scroll-trigger" href="#portfolio">De la arquitectura a los resultados <span aria-hidden="true">↓</span></a>
    </div>
  </div>
</header>

<style>
  .engineering-hero {
    --acento-portada: #82d3f7;
    position: relative;
    isolation: isolate;
    min-height: calc(100svh - 150px);
    display: grid;
    align-items: center;
    padding: 110px 0 20px;
    background: var(--fondo-principal);
  }
  .engineering-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    background: radial-gradient(ellipse at 82% 35%, var(--primario-suave), transparent 48%),
      linear-gradient(var(--borde) 1px, transparent 1px), linear-gradient(90deg, var(--borde) 1px, transparent 1px);
    background-size: auto, 64px 64px, 64px 64px;
    mask-image: linear-gradient(90deg, transparent 30%, #000 100%);
    opacity: .38;
  }
  .engineering-hero-layout { display: grid; grid-template-columns: minmax(0, 1.13fr) minmax(0, 1fr); align-items: center; column-gap: clamp(28px, 4vw, 68px); row-gap: 24px; }
  .engineering-hero-copy { min-width: 0; }
  .hero-identity { margin: 0 0 14px; font-size: .9rem; font-weight: 600; color: var(--texto-principal); }
  .hero-identity span { color: var(--texto-secundario); font-weight: 400; margin-left: 7px; }
  .hero-eyebrow { display: flex; align-items: center; gap: 9px; margin-bottom: 14px; color: var(--acento-portada); font-size: .68rem; font-weight: 700; letter-spacing: .17em; }
  .hero-eyebrow > span { width: 6px; height: 6px; background: currentColor; border-radius: 2px; }
  h1 { margin: 0 0 20px; color: var(--texto-principal); font-size: clamp(2.7rem, 3.95vw, 4.1rem); line-height: 1.09; font-weight: 700; letter-spacing: -.055em; text-wrap: balance; }
  h1 > span { color: var(--acento-portada); }
  .hero-description { max-width: 560px; margin: 0 0 16px; color: var(--texto-secundario); font-size: clamp(1rem, 1.25vw, 1.1rem); line-height: 1.7; }
  .hero-disciplines { display: flex; flex-wrap: wrap; gap: 6px 9px; margin: 0 0 22px; color: var(--texto-principal); font-size: .8rem; font-weight: 500; }
  .hero-disciplines span { color: var(--texto-tenue); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero-action { display: inline-flex; justify-content: center; align-items: center; min-height: 50px; gap: 14px; padding: 12px 20px; border: 1px solid transparent; border-radius: var(--radio-control); font-size: .84rem; font-weight: 700; text-decoration: none; transition: transform .2s, background .2s, border-color .2s; }
  .hero-action-primary { color: #07111f; background: #82d3f7; }
  .hero-action-primary:hover { color: #07111f; background: #a9e2fb; transform: translateY(-2px); }
  .hero-action-secondary { color: var(--texto-principal); border-color: var(--borde-destacado); background: var(--fondo-tarjeta-alternativo); }
  .hero-action-secondary:hover { color: var(--texto-principal); background: var(--primario-suave); border-color: var(--acento-portada); transform: translateY(-2px); }
  .hero-connections { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 20px; margin: 10px 0 20px; }
  .hero-connections a { display: inline-flex; align-items: center; gap: 7px; min-height: 35px; color: var(--texto-secundario); font-size: .78rem; text-decoration: none; }
  .hero-connections a:hover { color: var(--acento-portada); }
  .hero-connections a > span { color: var(--texto-tenue); }
  .hero-experience { color: var(--texto-secundario); font-size: .7rem; padding-left: 16px; border-left: 1px solid var(--borde-destacado); }
  .hero-bottom { grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-between; gap: 18px; padding-top: 12px; border-top: 1px solid var(--borde); color: var(--texto-secundario); font-size: .72rem; }
  .hero-bottom p { margin: 0; }
  .hero-bottom p > span { color: var(--acento-portada); margin-right: 8px; }
  .hero-bottom a { display: inline-flex; align-items: center; gap: 14px; min-height: 30px; color: var(--texto-secundario); text-decoration: none; }
  .hero-bottom a:hover { color: var(--acento-portada); }
  .hero-bottom a > span { color: var(--acento-portada); font-size: 1.1rem; }
  :global(html[data-theme='light']) .engineering-hero { --acento-portada: #096aaa; }
  :global(html[data-theme='light']) .hero-action-primary { background: #096aaa; color: #fff; }
  :global(html[data-theme='light']) .hero-action-primary:hover { background: #075489; }
  .hero-enter { animation: hero-enter .65s both; }
  .hero-enter:nth-child(2) { animation-delay: .06s; }
  .hero-enter:nth-child(3) { animation-delay: .12s; }
  .hero-enter:nth-child(4) { animation-delay: .18s; }
  .hero-enter:nth-child(5) { animation-delay: .24s; }
  .hero-enter:nth-child(6) { animation-delay: .3s; }
  .hero-enter:nth-child(7) { animation-delay: .36s; }
  @keyframes hero-enter { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  @media (min-width: 1400px) { .engineering-hero-layout { max-width: 1280px; } }
  @media (max-width: 1199px) { .engineering-hero-layout { max-width: 1080px; } h1 { font-size: clamp(2.6rem, 4.6vw, 3.65rem); } .hero-experience { border: 0; padding: 0; flex-basis: 100%; } }
  @media (max-width: 991px) { .engineering-hero { padding-top: 116px; } .engineering-hero-layout { column-gap: 26px; padding-inline: 26px; } h1 { font-size: clamp(2.5rem, 4.6vw, 3rem); } .hero-desktop-break { display: none; } .hero-identity { margin-bottom: 22px; } .hero-action { padding-inline: 15px; } .hero-bottom { font-size: .65rem; } }
  @media (max-width: 767px) {
    .engineering-hero { padding: 106px 0 22px; min-height: auto; }
    .engineering-hero-layout { grid-template-columns: minmax(0, 1fr); gap: 36px; padding-inline: 22px; }
    .engineering-hero-copy { max-width: 540px; }
    h1 { max-width: 530px; font-size: clamp(2.5rem, 8.6vw, 3.75rem); }
    .hero-description { font-size: 1rem; }
    .hero-identity { font-size: .82rem; margin-bottom: 23px; }
    .hero-eyebrow { font-size: .62rem; }
    .hero-disciplines { font-size: .73rem; gap: 6px; }
    .hero-experience { border-left: 1px solid var(--borde-destacado); padding-left: 14px; flex-basis: auto; }
    .hero-bottom { flex-direction: column; align-items: flex-start; gap: 4px; padding-top: 20px; font-size: .7rem; }
  }
  @media (max-width: 380px) { .engineering-hero-layout { padding-inline: 18px; } .hero-actions { flex-direction: column; } .hero-experience { padding: 0; border: 0; flex-basis: 100%; } }
  @media (prefers-reduced-motion: reduce) { .hero-enter { animation: none; } .hero-action { transition: none; } .hero-action:hover { transform: none; } }
</style>
