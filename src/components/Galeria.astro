<section class="gallery-editorial-section" id="gallery">
  <div class="container gallery-editorial-container">
    <header class="gallery-editorial-heading text-center">
      <span class="gallery-editorial-eyebrow">TRABAJO EN CONTEXTO</span>
      <h2 class="text-uppercase section-heading text-gradient">Galería Profesional</h2>
      <p class="section-subheading">Desarrollo, infraestructura e innovación aplicados en entornos institucionales y operativos.</p>
    </header>

    <div class="gallery-editorial-grid">
      {galeria.map((item, index) => (
        <figure class:list={['gallery-editorial-item', item.className]}>
          <img src={item.image} alt={item.alt} loading={index === 0 ? 'eager' : 'lazy'}>
          <figcaption>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
