---

<section class="gallery-editorial-section" id="gallery">
  <div class="container gallery-editorial-container">
    <header class="gallery-editorial-heading text-center">
      <span class="gallery-editorial-eyebrow">TRABAJO EN CONTEXTO</span>
      <h2 class="text-uppercase section-heading text-gradient">Galería Profesional</h2>
      <p class="section-subheading">Evidencias visuales de trabajo aplicado en modernización pública, infraestructura, interoperabilidad, soporte operativo y coordinación institucional.</p>
    </header>

    <div class="gallery-editorial-grid">
      {galeria.map((elemento, indice) => (
        <figure class:list={['gallery-editorial-item', elemento.clase]}>
          <img src={elemento.imagen} width={elemento.ancho} height={elemento.alto} alt={elemento.textoAlternativo} loading={indice === 0 ? 'eager' : 'lazy'} decoding="async">
          <figcaption>
            <span>{String(indice + 1).padStart(2, '0')}</span>
            <div>
              <h3>{elemento.titulo}</h3>
              <p>{elemento.descripcion}</p>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
