const modulosLibro = [
  { icon: 'fa-bell', title: 'Sistema de Notificaciones', detail: 'En app y correo electrónico' },
  { icon: 'fa-users', title: 'Configuración y Administración', detail: 'Gestión centralizada de usuarios y roles' },
  { icon: 'fa-warning', title: 'Registro de Anotaciones', detail: 'Incidentes y Disciplina' },
  { icon: 'fa-download', title: 'Visualización y Exportación', detail: 'Anotaciones con reportes descargables' },
  { icon: 'fa-bar-chart', title: 'Paneles de Estadísticas', detail: 'Gráficos interactivos de datos' },
  { icon: 'fa-puzzle-piece', title: 'Utilidades Compartidas', detail: 'Componentes y servicios del sistema' },
  { icon: 'fa-pencil-square-o', title: 'Portal Home Docentes', detail: 'Acceso y panel del Profesor' },
  { icon: 'fa-institution', title: 'Portal Home Director', detail: 'Panel de gestión directiva' },
  { icon: 'fa-university', title: 'Portal Home UTP', detail: 'Estadísticas, seguimiento, operaciones y actividades' },
  { icon: 'fa-id-card-o', title: 'Gestión de Matrículas', detail: 'Registro y control de matrículas' },
  { icon: 'fa-calendar-check-o', title: 'Control de Asistencia', detail: 'Seguimiento y registro diario' },
  { icon: 'fa-line-chart', title: 'Análisis y Exportación', detail: 'Reportes e informes descargables' },
  { icon: 'fa-check-square-o', title: 'Cumplimiento Estándar CEDS', detail: 'Estándar de datos educacionales' },
  { icon: 'fa-book', title: 'Gestión del Marco de Enseñanza', detail: 'Objetivos de aprendizaje y enseñanza' },
  { icon: 'fa-graduation-cap', title: 'Control Centralizado de Notas', detail: 'Por curso, período, mes y alumno para análisis y exportación' },
  { icon: 'fa-upload', title: 'Carga Masiva de Usuarios', detail: 'Docentes y apoderados desde CSV con validación y monitor de errores' },
  { icon: 'fa-image', title: 'Gestión de Imágenes', detail: 'Módulo para subida y cambios de fotos de estudiantes' },
  { icon: 'fa-search', title: 'Búsquedas Inteligentes', detail: 'Sistema contextual de módulos, opciones y funciones según rol' },
  { icon: 'fa-list-alt', title: 'Leccionario y Objetivos Curriculares', detail: 'Borrador, versionado, aprobación UTP, firma OTP, notificaciones y auditoría' },
