  {
    icon: 'fa-file-text-o',
    target: '10000',
    value: '10.000',
    suffix: '+',
    label: 'Ingresos a Trámites / año',
    desc: 'Solicitudes y flujos administrativos procesados anualmente en la plataforma institucional',
  },
  {
    icon: 'fa-check-circle',
    target: '100',
    value: '100',
