---

<section id="impacto" class="impacto-section">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center section-title">
                <h2 class="text-uppercase section-heading text-gradient">Impacto Profesional</h2>
                <div class="impacto-autoria">
                    <i class="fa fa-code"></i>Desarrollador Full Stack responsable de sistemas institucionales en operación para más de 70 establecimientos educacionales.
                </div>
            </div>
        </div>

        <div class="impacto-dashboard">
            <div class="impacto-kpi-grid" aria-label="Resultados principales">
                {resultadosClave.map((resultado) => (
                    <article class="impacto-kpi">
                        <div class="impacto-kpi-icon" aria-hidden="true"><i class={`fa ${resultado.icon}`}></i></div>
                        <div>
                            <div class="impacto-kpi-value">{resultado.value}</div>
                            <div class="impacto-kpi-label">{resultado.label}</div>
                        </div>
                    </article>
                ))}
            </div>

            <div class="impacto-category-list">
                {categoriasImpacto.map((categoria) => (
                    <article class="impacto-category-card">
                        <header class="impacto-category-header">
                            <div class="impacto-category-icon" aria-hidden="true"><i class={`fa ${categoria.icon}`}></i></div>
                            <div>
                                <h3>{categoria.title}</h3>
                                <p>{categoria.description}</p>
                            </div>
                        </header>
                        <div class="impacto-category-metrics">
                            {categoria.metrics.map((metrica) => (
                                <div class="impacto-category-metric">
                                    <strong>{metrica.value}</strong>
                                    <span>{metrica.label}</span>
                                </div>
                            ))}
                        </div>
                    </article>
                ))}
            </div>

            <div class="impacto-detail-row">
                <div class="impacto-card impacto-card-wide">
                    <div class="impacto-card-wide-header">
                        <div class="impacto-icon-wrap impacto-icon-wrap-wide">
                            <i class="fa fa-book impacto-icon"></i>
                        </div>
                        <div>
                            <div class="impacto-label impacto-label-wide">Libro de Clases Digital</div>
                            <p class="impacto-desc impacto-desc-wide">Plataforma integral de gestión educativa desarrollada de forma modular, cubriendo los principales ejes del proceso docente y directivo en establecimientos educacionales. Mejora el <strong>control de registros</strong>, potencia la <strong>toma de decisiones</strong> basada en datos, garantiza el <strong>respaldo</strong> de la información y facilita la <strong>planificación</strong> institucional.</p>
                        </div>
                    </div>

                    <div class="impacto-wide-modules">
                        {modulosLibro.map((modulo) => (
                                <div class:list={['impacto-module', `impacto-module--${modulo.layout}`]}>
                                <i class={`fa ${modulo.icon} impacto-module-icon`}></i>
                                <span class="impacto-module-text">{modulo.title}<br /><small>{modulo.detail}</small></span>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
