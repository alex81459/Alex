---

<section id="experiencia" class="about-section" aria-labelledby="experience-title">
  <div class="container career-container">
    <header class="career-heading section-intro text-center">
      <span class="career-eyebrow section-kicker">TRAYECTORIA PROFESIONAL</span>
      <h2 id="experience-title" class="text-uppercase section-heading">Experiencia</h2>
      <p class="section-subheading section-lead">Experiencia y formación construidas desde la operación técnica hasta el desarrollo de soluciones institucionales.</p>
    </header>

    <div class="career-timeline">
      {trayectoria.map((elemento, indice) => (
        <article class="career-entry">
          <div class="career-marker" aria-hidden="true">
            <span>{String(indice + 1).padStart(2, '0')}</span>
          </div>

          <div class="career-card">
            <div class="career-card-main">
              <img src={elemento.imagen} width="76" height="76" loading="lazy" alt={elemento.textoAlternativo}>
              <div class="career-card-copy">
                <span class="career-period">{elemento.periodo}</span>
                <h3>{elemento.organizacion}</h3>
                <span class="career-role">{elemento.cargo}</span>
                <p class="career-summary">{elemento.resumen}</p>
              </div>
            </div>

            <details class="career-details">
              <summary>
                <span>Ver trayectoria completa</span>
                <i class="fa fa-chevron-down" aria-hidden="true"></i>
              </summary>
              <div class="career-details-content">
                {elemento.detalles?.map((parrafo) => <p>{parrafo}</p>)}
                {elemento.hitos && (
                  <div class="career-education-list">
                    {elemento.hitos.map((hito) => (
                      <div class="career-education-item">
                        <span>{hito.anio}</span>
                        <div>
                          <h4>{hito.titulo}</h4>
                          <p>{hito.texto}</p>
                        </div>
                      </div>
                    ))}
                  </div>
                )}
                <div class="career-tags">
                  {elemento.etiquetas.map((etiqueta) => <span>{etiqueta}</span>)}
                </div>
              </div>
            </details>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
