---

<section id="about" class="about-section">
  <div class="container career-container">
    <header class="career-heading section-intro text-center">
      <span class="career-eyebrow section-kicker">TRAYECTORIA PROFESIONAL</span>
      <h2 class="text-uppercase section-heading">Acerca de mí</h2>
      <p class="section-subheading section-lead">Experiencia y formación construidas desde la operación técnica hasta el desarrollo de soluciones institucionales.</p>
    </header>

    <div class="career-timeline">
      {trayectoria.map((item, index) => (
        <article class="career-entry">
          <div class="career-marker" aria-hidden="true">
            <span>{String(index + 1).padStart(2, '0')}</span>
          </div>

          <div class="career-card">
            <div class="career-card-main">
              <img src={item.image} width="76" height="76" loading={index === 0 ? 'eager' : 'lazy'} alt={item.alt}>
              <div class="career-card-copy">
                <span class="career-period">{item.period}</span>
                <h3>{item.organization}</h3>
                <span class="career-role">{item.role}</span>
                <p class="career-summary">{item.summary}</p>
              </div>
            </div>

            <details class="career-details">
              <summary>
                <span>Ver trayectoria completa</span>
                <i class="fa fa-chevron-down" aria-hidden="true"></i>
              </summary>
              <div class="career-details-content">
                {item.details?.map((paragraph) => <p>{paragraph}</p>)}
                {item.milestones && (
                  <div class="career-education-list">
                    {item.milestones.map((milestone) => (
                      <div class="career-education-item">
                        <span>{milestone.year}</span>
                        <div>
                          <h4>{milestone.title}</h4>
                          <p>{milestone.text}</p>
                        </div>
                      </div>
                    ))}
                  </div>
                )}
                <div class="career-tags">
                  {item.tags.map((tag) => <span>{tag}</span>)}
                </div>
              </div>
            </details>
          </div>
        </article>
      ))}
    </div>

    <div class="career-cv">
      <div>
        <span>RESUMEN PROFESIONAL</span>
        <h3>Currículum Vitae</h3>
        <p>Descarga una versión resumida de mi experiencia, formación, competencias y principales resultados profesionales.</p>
      </div>
      <a href="assets/curriculum-v3-2026.pdf" target="_blank" rel="noopener">
        <i class="fa fa-download" aria-hidden="true"></i>
        Descargar CV
      </a>
    </div>
  </div>
</section>
