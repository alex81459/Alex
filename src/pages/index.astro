---
import DisenoPrincipal from '../layouts/MainLayout.astro';
import Portada from '../components/Hero.astro';
import Impacto from '../components/Impacto.astro';
import Servicios from '../components/Servicios.astro';
import Tecnologias from '../components/TechStack.astro';
import Certificaciones from '../components/Certificaciones.astro';
import Portafolio from '../components/Portafolio.astro';
import ProyectoDestacado from '../components/ProyectoDestacado.astro';
import ActualmenteConstruyendo from '../components/ActualmenteConstruyendo.astro';
import PaletaComandos from '../components/PaletaComandos.astro';
import Galeria from '../components/Galeria.astro';
import Experiencia from '../components/Experiencia.astro';
import Contacto from '../components/Contacto.astro';
import Modales from '../components/Modales.astro';
import Terminal from '../components/Terminal.astro';

const tituloPagina = 'Alex Salinas Ponce - Ingeniero de Software Full Stack';
const descripcionPagina = 'Ingeniero de Software Full Stack especializado en plataformas digitales, APIs e infraestructura tecnológica (DevOps). Python, Angular, Flask y soluciones empresariales.';
---

<DisenoPrincipal titulo={tituloPagina} descripcion={descripcionPagina} mostrarComandos>
  <Portada />
  <section id="caso-destacado" class="featured-project-section" aria-label="Caso de estudio destacado">
    <div class="container">
      <ProyectoDestacado />
    </div>
  </section>
  <Portafolio />
  <ActualmenteConstruyendo />
  <Impacto />
  <Experiencia />
  <Tecnologias />
  <Certificaciones />
  <Servicios />
  <Galeria />
  <Contacto />
  <PaletaComandos />
  <Modales />
  <Terminal />
</DisenoPrincipal>

<script>
  // Mejora progresiva: el contenido sigue visible sin JavaScript ni animaciones.
  const movimientoReducido = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (!movimientoReducido.matches && 'IntersectionObserver' in window) {
    const observador = new IntersectionObserver((entradas) => {
      entradas.forEach((entrada) => {
        if (!entrada.isIntersecting) return;
        observador.unobserve(entrada.target);
        if (!movimientoReducido.matches) entrada.target.animate(
          [{ opacity: .5, transform: 'translateY(10px)' }, { opacity: 1, transform: 'none' }],
          { duration: 200, easing: 'ease-out' },
        );
      });
    }, { threshold: .1 });
    document.querySelectorAll('main > section > .container > .section-intro, .portfolio-item, .tech-domain-card, .service-primary-card, .cert-featured-card, .impacto-category-card, .career-card, .contact-card, .building-card, .featured-project-layout, .system-map-surface').forEach((elemento) => observador.observe(elemento));
    movimientoReducido.addEventListener('change', () => {
      if (movimientoReducido.matches) document.getAnimations().forEach((animacion) => animacion.cancel());
    });
  }
</script>


<style>
  .featured-project-section {
    padding: 72px 0 0;
    background: var(--fondo-principal);
  }

  @media (max-width: 767px) {
    .featured-project-section { padding-top: 42px; }
  }
</style>
