---
interface Props {
  titulo?: string;
  descripcion?: string;
  mostrarComandos?: boolean;
}

const {
  titulo = 'Alex Salinas Ponce - Ingeniero de Software Full Stack',
  descripcion = 'Ingeniero de Software Full Stack especializado en plataformas digitales, APIs e infraestructura tecnológica (DevOps). Python, Angular, Flask y soluciones empresariales.',
  mostrarComandos = false,
} = Astro.props;

const rutaBase = import.meta.env.BASE_URL;
const urlSitio = new URL(rutaBase, Astro.site).href;
const urlCanonica = new URL(Astro.url.pathname, Astro.site).href;
const imagenPrevia = `${urlSitio}assets/img/preview.webp`;
---

<!DOCTYPE html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <base href={rutaBase} />
    <title>{titulo}</title>
    <meta name="description" content={descripcion}>
    <meta name="keywords" content="Alex Salinas Ponce, Ingeniero de Software, Full Stack, Infraestructura, DevOps, Python, Angular, Flask, SQLAlchemy, Administración TI, Gestión Proyectos, SLEP Colchagua, Johnson Fruit, Chimbarongo">
    <meta name="author" content="Alex Salinas Ponce">
    <meta name="robots" content="index, follow">
    <meta name="theme-color" content="#07111f">

    <meta property="og:title" content={titulo}>
    <meta property="og:description" content={descripcion}>
    <meta property="og:type" content="website">
    <meta property="og:url" content={urlCanonica}>
    <meta property="og:image" content={imagenPrevia}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={titulo}>
    <meta name="twitter:description" content={descripcion}>
    <meta name="twitter:image" content={imagenPrevia}>

    <link rel="canonical" href={urlCanonica} />
    <link rel="shortcut icon" href={`${rutaBase}favicon.png`} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfilePage",
      "mainEntity": {
        "@type": "Person",
        "name": "Alex Salinas Ponce",
        "jobTitle": "Ingeniero Informático",
        "image": imagenPrevia,
        "url": urlSitio,
        "sameAs": [
          "https://github.com/alex81459",
          "https://www.linkedin.com/in/alex-salinas-ponce-5276691a3"
        ],
        "worksFor": {
          "@type": "Organization",
          "name": "SLEP Colchagua"
        },
        "knowsAbout": [
          "Python",
          "JavaScript",
          "Angular",
          "Flask",
          "Node.js",
          "SQL",
          "APIs REST",
          "Web Development",
          "Full Stack Development",
          "IT Infrastructure",
          "Industrial Automation"
        ],
        "address": {
          "@type": "PostalAddress",
          "addressCountry": "CL",
          "addressRegion": "O'Higgins"
        }
      }
    })}></script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />

    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght;500;600;700&family=Montserrat:wght;600;700;800&display=swap" as="style" />
    <link rel="preload" href={`${rutaBase}assets/css/estilos-modificados.css`} as="style" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght;500;600;700&family=Montserrat:wght;600;700;800&display=swap" />
    <link rel="stylesheet" href={`${rutaBase}assets/fonts/fontawesome-all.min.css`} />
    <link rel="stylesheet" href={`${rutaBase}assets/fonts/font-awesome.min.css`} />
    <link rel="stylesheet" href={`${rutaBase}assets/fonts/fontawesome5-overrides.min.css`} />
    <link rel="stylesheet" href={`${rutaBase}assets/css/estilos-modificados.css`} />
    <script is:inline>
      (() => {
        const claveAlmacenamiento = 'alex-theme';
        const raiz = document.documentElement;

        try {
          const temaGuardado = localStorage.getItem(claveAlmacenamiento);
          if (temaGuardado === 'light' || temaGuardado === 'dark') {
            raiz.setAttribute('data-theme', temaGuardado);
            return;
          }
        } catch {}

        raiz.setAttribute('data-theme', 'dark');
      })();
    </script>
  </head>
  <body id="page-top">
    <div id="privacy-notice" class="privacy-notice" role="dialog" aria-labelledby="privacy-notice-title">
      <div class="privacy-notice-card">
        <div class="privacy-notice-icon" aria-hidden="true"><i class="fa fa-shield"></i></div>
        <div class="privacy-notice-body">
          <p id="privacy-notice-title" class="privacy-notice-title">Privacidad y transparencia</p>
          <p class="privacy-notice-text">
            Este sitio no utiliza cookies de rastreo ni recopila datos mediante formularios. Solo se guarda tu preferencia de tema en tu dispositivo y se cargan recursos de terceros (Google Fonts y Bootstrap CDN). Conoce los detalles en nuestra <a href={`${rutaBase}privacidad/`}>Política de Privacidad</a>.
          </p>
        </div>
        <div class="privacy-notice-actions">
          <button id="privacy-notice-accept" class="privacy-notice-btn" type="button">Entendido</button>
        </div>
      </div>
    </div>

    <script is:inline>
      (() => {
        const aviso = document.getElementById('privacy-notice');
        const boton = document.getElementById('privacy-notice-accept');
        const clave = 'alex-privacy-notice';
        if (!aviso || !boton) return;
        try {
          if (localStorage.getItem(clave) === 'accepted') return;
        } catch {}
        aviso.classList.add('is-visible');
        boton.addEventListener('click', () => {
          aviso.classList.remove('is-visible');
          try { localStorage.setItem(clave, 'accepted'); } catch {}
        });
      })();
    </script>

    <a href="#main-content" class="skip-link">Saltar al contenido principal</a>
    
    <div id="scroll-hud" class="scroll-hud" aria-live="off" aria-label="Indicador de sección actual">
      <div id="section-indicator" class="section-indicator">
        <span class="section-indicator-label">Inicio</span>
        <span id="section-indicator-value" class="section-indicator-value" aria-atomic="true">0%</span>
      </div>

      <button id="scroll-to-top" class="scroll-to-top-btn" type="button" aria-label="Volver arriba">
        <i class="fa fa-chevron-up"></i>
      </button>
    </div>

    <nav class="navbar navbar-dark navbar-expand-lg fixed-top bg-dark" id="mainNav" aria-label="Navegación principal">
      <div class="container">
        <a class="navbar-brand" href="#page-top" aria-label="Alex Salinas Ponce, inicio">
          <span class="navbar-brand-mark" aria-hidden="true">&lt;<span>/&gt;</span></span>
          <span class="navbar-brand-name">Alex Salinas<span>Ingeniero Informático · Desarrollador</span></span>
        </a>
        <button data-bs-toggle="collapse" data-bs-target="#navbarResponsive" class="navbar-toggler" type="button" aria-controls="navbarResponsive" aria-expanded="false" aria-label="Alternar navegación">
          <i class="fa fa-bars"></i>
        </button>
        <div class="collapse navbar-collapse" id="navbarResponsive">
          <ul class="nav navbar-nav flex-lg-row ms-auto">
            <li class="nav-item"><a class="nav-link js-scroll-trigger" href="#portfolio">Proyectos</a></li>
            <li class="nav-item"><a class="nav-link js-scroll-trigger" href="#experiencia">Experiencia</a></li>
            <li class="nav-item"><a class="nav-link js-scroll-trigger" href="#tech-stack">Tecnologías</a></li>
            <li class="nav-item"><a class="nav-link js-scroll-trigger" href="#about">Sobre mí</a></li>
            <li class="nav-item"><a class="nav-link js-scroll-trigger" href="#contact">Contacto</a></li>
          </ul>
        </div>
        {mostrarComandos && <button id="command-palette-trigger" class="command-palette-trigger" type="button" aria-label="Abrir comandos rápidos" aria-controls="command-palette" aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K">
          <i class="fa fa-search" aria-hidden="true"></i>
        </button>}
        <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Cambiar entre tema oscuro y claro" aria-pressed="false" title="Cambiar tema">
          <span class="theme-toggle-track">
            <i class="fa fa-sun-o theme-icon theme-icon-sun" aria-hidden="true"></i>
            <i class="fa fa-moon-o theme-icon theme-icon-moon" aria-hidden="true"></i>
            <span class="theme-toggle-thumb"></span>
          </span>
        </button>
      </div>
    </nav>

    <main id="main-content">
      <slot />
    </main>

    <script is:inline src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script is:inline src={`${rutaBase}assets/js/bootstrap5-init.js`}></script>
    <script is:inline src={`${rutaBase}assets/js/portfolio-init.js`}></script>
    <style>
      #mainNav { height: 80px; padding: 0; box-shadow: none; border-bottom: 1px solid var(--borde); background: var(--fondo-navegacion) !important; }
      #mainNav .container { max-width: 1280px; padding-inline: 22px; gap: 20px; }
      #mainNav .navbar-brand { display: inline-flex; align-items: center; gap: 14px; color: var(--texto-principal) !important; margin: 0 auto 0 0; padding: 0; font-size: .85rem; letter-spacing: 0; text-shadow: none; }
      #mainNav .navbar-brand:hover { transform: none; }
      #mainNav .navbar-brand-mark { display: inline-flex; align-items: center; width: auto; height: 40px; flex: 0 0 auto; border: 0; background: none; box-shadow: none; border-radius: 0; font-size: 1.55rem; font-weight: 700; letter-spacing: -.06em; }
      #mainNav .navbar-brand-mark > span { color: var(--primario); margin-left: 2px; }
      #mainNav .navbar-brand-name { display: block; font-weight: 600; }
      #mainNav .navbar-brand-name > span { display: block; margin-top: 3px; color: var(--texto-secundario); font-size: .59rem; font-weight: 400; }
      #mainNav .navbar-collapse { flex-grow: 0; }
      #mainNav .navbar-nav { width: auto; gap: 6px; }
      #mainNav .nav-link { display: flex; align-items: center; gap: 7px; padding: 10px 13px !important; margin: 0; border: 0; color: var(--texto-secundario) !important; text-transform: none; letter-spacing: 0; font-size: .77rem !important; font-weight: 500 !important; min-height: 44px; }
      #mainNav .nav-link::before { display: none; }
      #mainNav .nav-link:hover, #mainNav .nav-link.active { color: var(--texto-principal) !important; background: var(--primario-suave); box-shadow: none; transform: none; }
      #mainNav .nav-link > span { color: var(--texto-secundario); }
      #mainNav .theme-toggle { margin-left: 0; min-height: 44px; }
      #mainNav .command-palette-trigger { display: inline-flex; align-items: center; justify-content: center; gap: 6px; width: 48px; min-height: 44px; padding: 0; border: 1px solid var(--borde-destacado); border-radius: 8px; color: var(--texto-secundario); background: transparent; font-size: .75rem; }
      #mainNav .command-palette-trigger:hover { color: var(--texto-principal); border-color: var(--primario); background: var(--primario-suave); }
      #mainNav .command-palette-trigger kbd { padding: 0; border: 0; color: inherit; background: transparent; font: .58rem ui-monospace, SFMono-Regular, Consolas, monospace; }
      #mainNav .theme-toggle-track { box-shadow: none; }
      #mainNav .theme-toggle-thumb { background: var(--primario-suave); box-shadow: none; border: 1px solid var(--borde-destacado); }
      #mainNav .navbar-toggler { border: 1px solid var(--borde-destacado); border-radius: 8px; background: transparent; margin: 0; width: 44px; height: 44px; padding: 0; box-shadow: none; }
      #mainNav .navbar-toggler .fa-bars { color: var(--texto-principal); font-size: 1rem; }
      @media (max-width: 991.98px) {
        #mainNav .container { flex-wrap: wrap; gap: 12px; }
        #mainNav .navbar-brand { order: 0; max-width: none; }
        #mainNav .command-palette-trigger { order: 1; }
        #mainNav .theme-toggle { order: 2; }
        #mainNav .navbar-toggler { order: 3; }
        #mainNav .navbar-collapse { order: 4; position: absolute; top: 79px; left: 0; right: 0; margin: 0; padding: 0; background: var(--fondo-navegacion-movil); border-bottom: 1px solid var(--borde-destacado); border-radius: 0; box-shadow: 0 15px 25px -20px var(--sombra-flotante); max-height: calc(100svh - 80px); overflow-y: auto; }
        #mainNav .navbar-nav { width: 100%; padding: 12px 22px; gap: 2px; margin: 0; background: transparent; box-shadow: none; }
        #mainNav .nav-link { padding-inline: 14px !important; }
      }
      @media (max-width: 479px) { #mainNav .navbar-brand-name { display: none; } }

      .scroll-hud {
        position: fixed;
        right: 22px;
        bottom: 22px;
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 10px;
        z-index: 1100;
        pointer-events: none;
      }

      .scroll-hud .scroll-to-top-btn {
        position: relative;
        right: auto;
        bottom: auto;
        pointer-events: auto;
        z-index: 1;
      }

      .section-indicator {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 12px 16px;
        width: max-content;
        max-width: max-content;
        border-radius: 999px;
        background: var(--fondo-indicador);
        border: 1px solid var(--borde-indicador);
        color: var(--texto-principal);
        font-size: 0.92rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        box-shadow: 0 18px 40px var(--sombra-flotante);
        backdrop-filter: blur(14px);
        opacity: 0;
        transform: translateY(8px);
        transition: opacity 0.2s ease, filter 0.2s ease, transform 0.2s ease;
        z-index: 1100;
        pointer-events: none;
        white-space: nowrap;
        filter: drop-shadow(0 12px 30px var(--sombra-flotante));
      }

      .section-indicator.show {
        opacity: 1;
        transform: translateY(0);
      }

      .section-indicator-label {
        color: var(--texto-secundario);
      }

      .section-indicator-value {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 52px;
        padding: 4px 10px;
        border-radius: 999px;
        background: linear-gradient(135deg, var(--primario-suave), rgba(103, 232, 249, 0.2));
        color: var(--texto-principal);
        font-size: 0.82rem;
      }

      .theme-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-left: 14px;
        padding: 0;
        border: 0;
        background: transparent;
        box-shadow: none;
        flex: 0 0 auto;
      }

      .theme-toggle-track {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        width: 78px;
        height: 42px;
        padding: 0 12px;
        border-radius: 999px;
        background: var(--superficie-navegacion);
        border: 1px solid var(--borde-destacado);
        box-shadow: 0 12px 28px var(--sombra-flotante);
        backdrop-filter: blur(16px);
      }

      .theme-icon {
        position: relative;
        z-index: 1;
        color: var(--texto-secundario);
        font-size: 0.95rem;
        transition: color 0.25s ease, transform 0.25s ease;
      }

      .theme-icon-sun {
        margin-left: 1px;
      }

      .theme-icon-moon {
        margin-right: 1px;
      }

      .theme-toggle-thumb {
        position: absolute;
        top: 4px;
        left: 4px;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--primario), var(--secundario));
        box-shadow: 0 8px 24px rgba(56, 189, 248, 0.35);
        transition: transform 0.25s ease;
      }

      html[data-theme='dark'] .theme-toggle-thumb {
        transform: translateX(36px);
      }

      html[data-theme='dark'] .theme-icon-moon,
      html[data-theme='light'] .theme-icon-sun {
        color: var(--texto-principal);
        transform: scale(1.05);
      }

      .privacy-notice {
        position: fixed;
        right: 16px;
        bottom: 16px;
        left: 16px;
        z-index: 1040;
        display: none;
      }

      .privacy-notice.is-visible {
        display: block;
      }

      .privacy-notice-card {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 14px 18px;
        max-width: 780px;
        margin: 0 auto;
        padding: 16px 18px;
        color: var(--texto-principal);
        background: var(--fondo-indicador);
        border: 1px solid var(--borde-indicador);
        border-radius: 16px;
        box-shadow: 0 18px 40px var(--sombra-flotante);
        backdrop-filter: blur(14px);
      }

      .privacy-notice-icon {
        display: inline-flex;
        flex: 0 0 auto;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        color: #8feaff;
        font-size: 1.2rem;
        background: linear-gradient(145deg, rgba(32, 148, 255, 0.18), rgba(0, 212, 255, 0.08));
        border: 1px solid rgba(32, 148, 255, 0.35);
        border-radius: 12px;
      }

      .privacy-notice-body {
        flex: 1 1 260px;
        min-width: 0;
      }

      .privacy-notice-title {
        margin: 0 0 4px;
        font-size: 0.95rem;
        font-weight: 700;
      }

      .privacy-notice-text {
        margin: 0;
        color: var(--texto-secundario);
        font-size: 0.86rem;
        line-height: 1.5;
      }

      .privacy-notice-text a {
        color: #8feaff;
        font-weight: 600;
        text-decoration: underline;
      }

      .privacy-notice-actions {
        flex: 0 0 auto;
      }

      .privacy-notice-btn {
        padding: 10px 18px;
        color: var(--fondo-principal);
        font-size: 0.88rem;
        font-weight: 700;
        cursor: pointer;
        background: linear-gradient(135deg, var(--primario), var(--secundario));
        border: 0;
        border-radius: 999px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .privacy-notice-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 24px rgba(56, 189, 248, 0.3);
      }

      html[data-theme='light'] .privacy-notice-icon {
        color: var(--primario);
        background: linear-gradient(145deg, rgba(20, 142, 234, 0.12), rgba(57, 194, 221, 0.08));
        border-color: rgba(20, 142, 234, 0.22);
      }

      html[data-theme='light'] .privacy-notice-text a {
        color: var(--primario);
      }

      html[data-theme='light'] .privacy-notice-btn {
        color: #ffffff;
      }

      @media (max-width: 768px) {
        .scroll-hud {
          right: 16px;
          bottom: 16px;
          gap: 8px;
        }

        .scroll-hud .scroll-to-top-btn {
          right: auto;
          bottom: auto;
        }

        .section-indicator {
          padding: 10px 14px;
          font-size: 0.84rem;
        }

        .section-indicator-value {
          min-width: 46px;
          font-size: 0.76rem;
        }

        .theme-toggle-track {
          width: 72px;
          height: 40px;
          justify-content: space-between;
          padding: 0 11px;
        }

        .theme-toggle-thumb {
          width: 30px;
          height: 30px;
        }

        html[data-theme='dark'] .theme-toggle-thumb {
          transform: translateX(31px);
        }
      }

      @media (max-width: 575.98px) {
        .privacy-notice {
          right: max(10px, env(safe-area-inset-right));
          bottom: max(10px, env(safe-area-inset-bottom));
          left: max(10px, env(safe-area-inset-left));
        }

        .privacy-notice-card {
          display: grid;
          grid-template-columns: 36px minmax(0, 1fr);
          gap: 10px 12px;
          max-height: min(42vh, 320px);
          padding: 12px;
          overflow-y: auto;
          overscroll-behavior: contain;
          border-radius: 14px;
        }

        .privacy-notice-icon {
          width: 36px;
          height: 36px;
          font-size: 1rem;
          border-radius: 10px;
        }

        .privacy-notice-body {
          flex: none;
        }

        .privacy-notice-title {
          margin-bottom: 3px;
          font-size: 0.9rem;
          line-height: 1.25;
        }

        .privacy-notice-text {
          font-size: 0.78rem;
          line-height: 1.42;
        }

        .privacy-notice-actions {
          grid-column: 2;
          justify-self: start;
        }

        .privacy-notice-btn {
          min-height: 38px;
          padding: 8px 16px;
          font-size: 0.82rem;
        }
      }

      /* Accesibilidad: Skip Link */
      .skip-link {
        position: absolute;
        top: -40px;
        left: 0;
        background: #000;
        color: #fff;
        padding: 8px;
        z-index: 100;
        text-decoration: none;
      }

      .skip-link:focus {
        top: 0;
      }

      /* Accesibilidad: Visually Hidden */
      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border-width: 0;
      }

      /* Respeta prefers-reduced-motion */
      @media (prefers-reduced-motion: reduce) {
        * {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }

        .section-indicator {
          transition: none;
        }

        .scroll-hud .scroll-to-top-btn {
          transition: none;
        }

        #mainNav .navbar-collapse.show .navbar-nav {
          animation: none;
        }
      }
    </style>
  </body>
</html>
