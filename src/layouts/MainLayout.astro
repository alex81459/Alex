---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Alex Salinas Ponce - Ingeniero de Software Full Stack',
  description = 'Ingeniero de Software Full Stack especializado en plataformas digitales, APIs e infraestructura tecnológica (DevOps). Python, Angular, Flask y soluciones empresariales.',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const siteUrl = `${Astro.site}${base}`;
const previewImage = `${siteUrl}assets/img/preview.webp`;
---

<!DOCTYPE html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <base href={base}>
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="keywords" content="Alex Salinas Ponce, Ingeniero de Software, Full Stack, Infraestructura, DevOps, Python, Angular, Flask, SQLAlchemy, Administración TI, Gestión Proyectos, SLEP Colchagua, Johnson Fruit, Chimbarongo">
    <meta name="author" content="Alex Salinas Ponce">
    <meta name="robots" content="index, follow">
    <meta name="theme-color" content="#07111f">

    <meta property="og:title" content="Alex Salinas Ponce - Ingeniero de Software Full Stack">
    <meta property="og:description" content="Ingeniero de Software Full Stack especializado en plataformas digitales, APIs e infraestructura tecnológica">
    <meta property="og:type" content="website">
    <meta property="og:url" content={siteUrl}>
    <meta property="og:image" content={previewImage}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Alex Salinas Ponce - Ingeniero de Software Full Stack">
    <meta name="twitter:description" content="Desarrollo sistemas web, APIs e infraestructura TI para digitalizar procesos institucionales.">
    <meta name="twitter:image" content={previewImage}>

    <link rel="canonical" href={siteUrl}>
    <link rel="shortcut icon" href={`${base}favicon.png`}>

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfilePage",
      "mainEntity": {
        "@type": "Person",
        "name": "Alex Salinas Ponce",
        "jobTitle": "Ingeniero Informático",
        "image": previewImage,
        "url": siteUrl,
        "sameAs": [
          "https://github.com/alex81459",
          "https://www.linkedin.com/in/alex-salinas-ponce-5276691a3"
        ],
        "worksFor": {
          "@type": "Organization",
          "name": "SLEP Colchagua"
        },
        "knowsAbout": [
          "Python",
          "JavaScript",
          "Angular",
          "Flask",
          "Node.js",
          "SQL",
          "APIs REST",
          "Web Development",
          "Full Stack Development",
          "IT Infrastructure",
          "Industrial Automation"
        ],
        "address": {
          "@type": "PostalAddress",
          "addressCountry": "CL",
          "addressRegion": "O'Higgins"
        }
      }
    })}></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>

    <link rel="preload" href="https://fonts.googleapis.com/css?family=Montserrat:400,700" as="style">
    <link rel="preload" href={`${base}assets/css/estilos-modificados.css`} as="style">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Montserrat:400,700">
    <link rel="stylesheet" href={`${base}assets/fonts/fontawesome-all.min.css`}>
    <link rel="stylesheet" href={`${base}assets/fonts/font-awesome.min.css`}>
    <link rel="stylesheet" href={`${base}assets/fonts/fontawesome5-overrides.min.css`}>
    <link rel="stylesheet" href={`${base}assets/css/estilos-modificados.css`}>
    <script is:inline>
      (() => {
        const storageKey = 'alex-theme';
        const root = document.documentElement;

        try {
          const savedTheme = localStorage.getItem(storageKey);
          if (savedTheme === 'light' || savedTheme === 'dark') {
            root.setAttribute('data-theme', savedTheme);
            return;
          }
        } catch {}

        root.setAttribute('data-theme', 'dark');
      })();
    </script>
  </head>
  <body id="page-top">
    <div id="privacy-notice" class="privacy-notice" role="dialog" aria-labelledby="privacy-notice-title">
      <div class="privacy-notice-card">
        <div class="privacy-notice-icon" aria-hidden="true"><i class="fa fa-shield"></i></div>
        <div class="privacy-notice-body">
          <p id="privacy-notice-title" class="privacy-notice-title">Privacidad y transparencia</p>
          <p class="privacy-notice-text">
            Este sitio no utiliza cookies de rastreo ni recopila datos mediante formularios. Solo se guarda tu preferencia de tema en tu dispositivo y se cargan recursos de terceros (Google Fonts y Bootstrap CDN). Conoce los detalles en nuestra <a href={`${base}privacidad/`}>Política de Privacidad</a>.
          </p>
        </div>
        <div class="privacy-notice-actions">
          <button id="privacy-notice-accept" class="privacy-notice-btn" type="button">Entendido</button>
        </div>
      </div>
    </div>

    <script is:inline>
      (() => {
        const notice = document.getElementById('privacy-notice');
        const btn = document.getElementById('privacy-notice-accept');
        const key = 'alex-privacy-notice';
        if (!notice || !btn) return;
        try {
          if (localStorage.getItem(key) === 'accepted') return;
        } catch {}
        notice.classList.add('is-visible');
        btn.addEventListener('click', () => {
          notice.classList.remove('is-visible');
          try { localStorage.setItem(key, 'accepted'); } catch {}
        });
      })();
    </script>

    <a href="#main-content" class="skip-link">Saltar al contenido principal</a>
    
    <div id="loading-overlay" class="loading-overlay">
      <div class="loading-spinner">
        <div class="spinner-ring"></div>
        <div class="spinner-ring"></div>
        <div class="spinner-ring"></div>
        <div class="spinner-ring"></div>
        <p class="loading-text">Cargando Portafolio...</p>
      </div>
    </div>

    <div id="scroll-hud" class="scroll-hud" aria-live="off" aria-label="Indicador de sección actual">
      <div id="section-indicator" class="section-indicator">
        <span class="section-indicator-label">Inicio</span>
        <span id="section-indicator-value" class="section-indicator-value" aria-atomic="true">0%</span>
      </div>

      <button id="scroll-to-top" class="scroll-to-top-btn" type="button" aria-label="Volver arriba">
        <i class="fa fa-chevron-up"></i>
      </button>
    </div>

    <nav class="navbar navbar-dark navbar-expand-lg fixed-top bg-dark" id="mainNav">
      <div class="container">
        <a class="navbar-brand" href="#page-top">
          <span class="navbar-brand-mark" aria-hidden="true"><i class="fa fa-code"></i></span>
          <span class="navbar-brand-name">Alex Salinas Ponce</span>
        </a>
        <button data-bs-toggle="collapse" data-bs-target="#navbarResponsive" class="navbar-toggler" type="button" aria-controls="navbarResponsive" aria-expanded="false" aria-label="Alternar navegación">
          <i class="fa fa-bars"></i>
        </button>
        <div class="collapse navbar-collapse" id="navbarResponsive">
          <ul class="nav navbar-nav text-uppercase flex-lg-row ms-auto">
            <li class="nav-item"><a class="nav-link js-scroll-trigger" href="#services">SERVICIOS</a></li>
            <li class="nav-item"><a class="nav-link js-scroll-trigger" href="#tech-stack">STACK</a></li>
            <li class="nav-item"><a class="nav-link js-scroll-trigger" href="#certifications">CERTIFICADOS</a></li>
            <li class="nav-item"><a class="nav-link js-scroll-trigger" href="#portfolio">PORTAFOLIO</a></li>
            <li class="nav-item"><a class="nav-link js-scroll-trigger" href="#gallery">GALERÍA</a></li>
            <li class="nav-item"><a class="nav-link js-scroll-trigger" href="#about">ACERCA DE</a></li>
            <li class="nav-item"><a class="nav-link js-scroll-trigger fw-bold" style="color: var(--primary)" href="#contact">CONTACTO</a></li>
          </ul>
        </div>
        <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Cambiar entre tema oscuro y claro" aria-pressed="false" title="Cambiar tema">
          <span class="theme-toggle-track">
            <i class="fa fa-sun-o theme-icon theme-icon-sun" aria-hidden="true"></i>
            <i class="fa fa-moon-o theme-icon theme-icon-moon" aria-hidden="true"></i>
            <span class="theme-toggle-thumb"></span>
          </span>
        </button>
      </div>
    </nav>

    <main id="main-content">
      <slot />
    </main>

    <script is:inline src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script is:inline src={`${base}assets/js/bootstrap5-init.js`}></script>
    <script is:inline src={`${base}assets/js/portfolio-init.js`}></script>
    <style>
      .scroll-hud {
        position: fixed;
        right: 22px;
        bottom: 22px;
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 10px;
        z-index: 1100;
        pointer-events: none;
      }

      .scroll-hud .scroll-to-top-btn {
        position: relative;
        right: auto;
        bottom: auto;
        pointer-events: auto;
        z-index: 1;
      }

      .section-indicator {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 12px 16px;
        width: max-content;
        max-width: max-content;
        border-radius: 999px;
        background: var(--hud-bg);
        border: 1px solid var(--hud-border);
        color: var(--text-main);
        font-size: 0.92rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        box-shadow: 0 18px 40px var(--floating-shadow);
        backdrop-filter: blur(14px);
        opacity: 0;
        transform: translateY(8px);
        transition: opacity 0.2s ease, filter 0.2s ease, transform 0.2s ease;
        z-index: 1100;
        pointer-events: none;
        white-space: nowrap;
        filter: drop-shadow(0 12px 30px var(--floating-shadow));
      }

      .section-indicator.show {
        opacity: 1;
        transform: translateY(0);
      }

      .section-indicator-label {
        color: var(--text-secondary);
      }

      .section-indicator-value {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 52px;
        padding: 4px 10px;
        border-radius: 999px;
        background: linear-gradient(135deg, var(--primary-soft), rgba(103, 232, 249, 0.2));
        color: var(--text-main);
        font-size: 0.82rem;
      }

      .theme-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-left: 14px;
        padding: 0;
        border: 0;
        background: transparent;
        box-shadow: none;
        flex: 0 0 auto;
      }

      .theme-toggle-track {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        width: 78px;
        height: 42px;
        padding: 0 12px;
        border-radius: 999px;
        background: var(--nav-surface);
        border: 1px solid var(--border-strong);
        box-shadow: 0 12px 28px var(--floating-shadow);
        backdrop-filter: blur(16px);
      }

      .theme-icon {
        position: relative;
        z-index: 1;
        color: var(--text-secondary);
        font-size: 0.95rem;
        transition: color 0.25s ease, transform 0.25s ease;
      }

      .theme-icon-sun {
        margin-left: 1px;
      }

      .theme-icon-moon {
        margin-right: 1px;
      }

      .theme-toggle-thumb {
        position: absolute;
        top: 4px;
        left: 4px;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--primary), var(--secondary));
        box-shadow: 0 8px 24px rgba(56, 189, 248, 0.35);
        transition: transform 0.25s ease;
      }

      html[data-theme='dark'] .theme-toggle-thumb {
        transform: translateX(36px);
      }

      html[data-theme='dark'] .theme-icon-moon,
      html[data-theme='light'] .theme-icon-sun {
        color: var(--text-main);
        transform: scale(1.05);
      }

      .privacy-notice {
        position: fixed;
        right: 16px;
        bottom: 16px;
        left: 16px;
        z-index: 1040;
        display: none;
      }

      .privacy-notice.is-visible {
        display: block;
      }

      .privacy-notice-card {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 14px 18px;
        max-width: 780px;
        margin: 0 auto;
        padding: 16px 18px;
        color: var(--text-main);
        background: var(--hud-bg);
        border: 1px solid var(--hud-border);
        border-radius: 16px;
        box-shadow: 0 18px 40px var(--floating-shadow);
        backdrop-filter: blur(14px);
      }

      .privacy-notice-icon {
        display: inline-flex;
        flex: 0 0 auto;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        color: #8feaff;
        font-size: 1.2rem;
        background: linear-gradient(145deg, rgba(32, 148, 255, 0.18), rgba(0, 212, 255, 0.08));
        border: 1px solid rgba(32, 148, 255, 0.35);
        border-radius: 12px;
      }

      .privacy-notice-body {
        flex: 1 1 260px;
        min-width: 0;
      }

      .privacy-notice-title {
        margin: 0 0 4px;
        font-size: 0.95rem;
        font-weight: 700;
      }

      .privacy-notice-text {
        margin: 0;
        color: var(--text-secondary);
        font-size: 0.86rem;
        line-height: 1.5;
      }

      .privacy-notice-text a {
        color: #8feaff;
        font-weight: 600;
        text-decoration: underline;
      }

      .privacy-notice-actions {
        flex: 0 0 auto;
      }

      .privacy-notice-btn {
        padding: 10px 18px;
        color: var(--bg-main);
        font-size: 0.88rem;
        font-weight: 700;
        cursor: pointer;
        background: linear-gradient(135deg, var(--primary), var(--secondary));
        border: 0;
        border-radius: 999px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .privacy-notice-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 24px rgba(56, 189, 248, 0.3);
      }

      html[data-theme='light'] .privacy-notice-icon {
        color: var(--primary);
        background: linear-gradient(145deg, rgba(20, 142, 234, 0.12), rgba(57, 194, 221, 0.08));
        border-color: rgba(20, 142, 234, 0.22);
      }

      html[data-theme='light'] .privacy-notice-text a {
        color: var(--primary);
      }

      html[data-theme='light'] .privacy-notice-btn {
        color: #ffffff;
      }

      @media (max-width: 1314.98px) {
        #mainNav .container {
          display: flex;
          flex-wrap: wrap;
          align-items: center;
          justify-content: flex-start;
          max-width: 100%;
          gap: 0;
          padding-left: 15px;
          padding-right: 15px;
        }

        #mainNav .navbar-brand {
          order: 1;
          margin-right: auto;
          gap: 8px;
          max-width: calc(100% - 76px);
          color: var(--primary-color) !important;
          font-size: 1.3rem !important;
          font-weight: 700;
        }

        #mainNav .navbar-brand-mark {
          width: 34px;
          height: 34px;
          flex-basis: 34px;
          border-radius: 9px;
          font-size: 0.92rem;
        }

        #mainNav .navbar-brand-name {
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }

        #mainNav .navbar-toggler {
          display: block !important;
          order: 2;
          position: relative;
          z-index: 1051;
          margin-left: 12px;
        }

        #mainNav .theme-toggle {
          order: 2;
          margin-left: auto;
        }

        #mainNav .navbar-collapse {
          display: none !important;
          position: fixed !important;
          top: 80px !important;
          left: 0 !important;
          right: 0 !important;
          order: 3;
          width: 100%;
          max-width: 100%;
          max-height: calc(100vh - 80px);
          overflow-y: auto;
          margin-top: 0;
          padding: 0;
          background: var(--nav-mobile-bg);
          backdrop-filter: blur(10px);
          border-radius: 0 0 15px 15px;
          box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
        }

        #mainNav .navbar-collapse.show {
          display: block !important;
          width: 100%;
        }

        #mainNav .navbar-collapse.collapsing {
          display: block !important;
          width: 100%;
        }

        #mainNav .navbar-nav {
          position: static !important;
          width: 100%;
          margin-left: 0 !important;
          background: var(--nav-mobile-bg);
          backdrop-filter: blur(10px);
          border-radius: 0 0 15px 15px;
          padding: 15px 0;
          box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
          flex-direction: column !important;
          align-items: flex-start;
          text-align: left;
        }

        #mainNav .navbar-collapse.show .navbar-nav {
          animation: navSlideDown1315 0.3s ease-out;
        }

        #mainNav .nav-link {
          display: block;
          width: 100%;
          padding: 12px 25px !important;
          margin: 0;
          border-radius: 0;
          white-space: normal;
          background: transparent;
          border-color: transparent;
          box-shadow: none;
          transform: none;
        }

        #mainNav .nav-link:hover {
          background: var(--primary-soft);
          border-color: transparent;
          transform: none;
          box-shadow: none;
        }
      }

      @keyframes navSlideDown1315 {
        0% {
          opacity: 0;
          transform: translateY(-10px);
        }
        100% {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @media (max-width: 768px) {
        .scroll-hud {
          right: 16px;
          bottom: 16px;
          gap: 8px;
        }

        .scroll-hud .scroll-to-top-btn {
          right: auto;
          bottom: auto;
        }

        .section-indicator {
          padding: 10px 14px;
          font-size: 0.84rem;
        }

        .section-indicator-value {
          min-width: 46px;
          font-size: 0.76rem;
        }

        .theme-toggle-track {
          width: 72px;
          height: 40px;
          justify-content: space-between;
          padding: 0 11px;
        }

        .theme-toggle-thumb {
          width: 30px;
          height: 30px;
        }

        html[data-theme='dark'] .theme-toggle-thumb {
          transform: translateX(31px);
        }
      }

      @media (max-width: 575.98px) {
        .privacy-notice {
          right: max(10px, env(safe-area-inset-right));
          bottom: max(10px, env(safe-area-inset-bottom));
          left: max(10px, env(safe-area-inset-left));
        }

        .privacy-notice-card {
          display: grid;
          grid-template-columns: 36px minmax(0, 1fr);
          gap: 10px 12px;
          max-height: min(42vh, 320px);
          padding: 12px;
          overflow-y: auto;
          overscroll-behavior: contain;
          border-radius: 14px;
        }

        .privacy-notice-icon {
          width: 36px;
          height: 36px;
          font-size: 1rem;
          border-radius: 10px;
        }

        .privacy-notice-body {
          flex: none;
        }

        .privacy-notice-title {
          margin-bottom: 3px;
          font-size: 0.9rem;
          line-height: 1.25;
        }

        .privacy-notice-text {
          font-size: 0.78rem;
          line-height: 1.42;
        }

        .privacy-notice-actions {
          grid-column: 2;
          justify-self: start;
        }

        .privacy-notice-btn {
          min-height: 38px;
          padding: 8px 16px;
          font-size: 0.82rem;
        }
      }

      /* Accesibilidad: Skip Link */
      .skip-link {
        position: absolute;
        top: -40px;
        left: 0;
        background: #000;
        color: #fff;
        padding: 8px;
        z-index: 100;
        text-decoration: none;
      }

      .skip-link:focus {
        top: 0;
      }

      /* Accesibilidad: Visually Hidden */
      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border-width: 0;
      }

      /* Respeta prefers-reduced-motion */
      @media (prefers-reduced-motion: reduce) {
        * {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }

        .section-indicator {
          transition: none;
        }

        .scroll-hud .scroll-to-top-btn {
          transition: none;
        }

        #mainNav .navbar-collapse.show .navbar-nav {
          animation: none;
        }
      }
    </style>
  </body>
</html>
